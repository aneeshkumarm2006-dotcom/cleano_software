# Patterns without a leading slash match in every app and package, which is
# what a monorepo needs: apps/web/.next is as much a build artefact as .next was.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — local secrets, one set per app, never committed
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Data exports / imports (may contain PII)
*.csv

# Design handoff reference (not shipped)
.design-ref/

# Screenshot output from the review and verify scripts
shots/
shots-all/
shots-cleaner/

# Browser-test harness: the scripts and FINDINGS.md are worth keeping, but
# accounts.json holds a login password for the throwaway test users. Never
# commit a credential file, even for accounts that have since been deleted.
**/_bt/accounts.json

# Playwright MCP session artifacts
.playwright-mcp/

# Turborepo local cache and logs
.turbo/
