# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Data exports / imports (may contain PII)
*.csv

# Design handoff reference (not shipped)
.design-ref/
.env.e2e
scripts/shots/
scripts/shots-all/
scripts/shots-cleaner/

# Browser-test harness: the scripts and FINDINGS.md are worth keeping, but
# accounts.json holds a login password for the throwaway test users. Never
# commit a credential file, even for accounts that have since been deleted.
_bt/accounts.json
