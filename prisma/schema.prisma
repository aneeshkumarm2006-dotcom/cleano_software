}

model Lead {
  id             String     @id @default(cuid())
  email          String
  name           String?
  phone          String?
  postalCode     String?
  dropOffStep    Int?
  serviceType    String?
  bedCount       Int?
  bathCount      Int?
  halfBathCount  Int?
  squareFootage  Int?
  preferredDate  DateTime?
  isFlexible     Boolean    @default(false)
  preferredSlot  String?
  payload        Json?
  status         LeadStatus @default(NEW)
  source         String?
  convertedJobId String?
  convertedAt    DateTime?
  lastActivityAt DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  convertedJob   Job?       @relation(fields: [convertedJobId], references: [id], onDelete: SetNull)
  contact        Contact?

  @@index([email])
  @@index([status])
  @@index([lastActivityAt])
}

/// Unified CRM record. One Contact spans a person's whole lifecycle — lead,
/// client, applicant, cleaner — and back-links to the operational Client/Lead
/// rows it was created from (additive: existing tables are untouched).
/// Queryable CRM columns are first-class; the flexible property-card fields
/// (bedrooms, sqft, frequency, …) live in `props` until a full property-
/// definition engine is built.
model Contact {
  id                 String            @id @default(cuid())
  name               String
  email              String?
  phone              String?
  address            String?
  lifecycle          LifecycleStage    @default(NEW_LEAD)
  source             String?
  sourceDetail       String?
  latestSource       String?
  campaign           String?
  ownerId            String? // soft reference to User (CRM owner / rep)
  leadScore          Int?
  nextStep           String?
  nextStepDue        DateTime?
  tags               String[]          @default([])
  props              Json? // flexible property bag — drives the property cards
  ratingAvg          Float?
  ratingCount        Int               @default(0)
  lifetimeValue      Float             @default(0)
  bookingsCount      Int               @default(0)
  duplicateDismissed Boolean           @default(false)
  archivedAt         DateTime?
  clientId           String?           @unique
  leadId             String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lastActivityAt     DateTime          @default(now())
  client             Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead               Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  activities         ContactActivity[]

  @@index([lifecycle])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@index([email])
  @@index([phone])
}

/// Mixed-type timeline entry on a Contact (note, call, email, lifecycle change…).
model ContactActivity {
  id        String              @id @default(cuid())
  contactId String
  type      ContactActivityType @default(NOTE)
  title     String
  body      String?
  actor     String?
  createdAt DateTime            @default(now())
  contact   Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
}

enum LifecycleStage {
  NEW_LEAD
  QUALIFIED
  BOOKED
  ACTIVE
  RETURNING
  PAST
  LOST
  APPLICANT
  CLEANER
  DNC
}

enum ContactActivityType {
  NOTE
  EMAIL
  SMS
  CALL
  BOOKING
  RATING
  CANCEL
  LIFECYCLE
  CREATE
}

/// HubSpot-style property registry. Defines the editable fields ("properties")
/// available on each CRM object. System properties are locked from deletion and
/// internal-name/type changes after creation.
model PropertyDefinition {
  id           String    @id @default(cuid())
  objectType   String // contact | company | booking
  groupName    String
  label        String
  internalName String
  fieldType    String // text|textarea|number|email|phone|date|dropdown|multi|checkbox|user
  options      String[]  @default([])
  isSystem     Boolean   @default(false)
  isRequired   Boolean   @default(false)
  isUnique     Boolean   @default(false)
  visibility   String    @default("everyone") // everyone | admin
  sortOrder    Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([objectType, internalName])
  @@index([objectType])
}

/// Marketing ad-spend entries (manual or CSV import) used to compute true CPA
/// by channel. Funnel metrics are derived live from Contact source/lifecycle.
model AdSpendImport {
  id           String   @id @default(cuid())
  channel      String // normalized channel id: google | instagram | facebook | …
  date         DateTime
  amount       Float
  source       String? // "Manual" | "CSV · file.csv"
  importedById String?
  createdAt    DateTime @default(now())

  @@index([channel])
  @@index([date])
}

model Waitlist {
  id             String         @id @default(cuid())
  preferredDate  DateTime
  email          String
  name           String?
  phone          String?
  clientId       String?
  serviceType    String?
  bedCount       Int?
  bathCount      Int?
  notes          String?
  status         WaitlistStatus @default(WAITING)
  notifiedAt     DateTime?
  convertedJobId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  convertedJob   Job?           @relation(fields: [convertedJobId], references: [id], onDelete: SetNull)

  @@index([preferredDate])
  @@index([status])
  @@index([email])
}

model EmailLog {
  id              String      @id @default(cuid())
  kind            EmailKind
  recipient       String
  subject         String?
  status          EmailStatus @default(PENDING)
  jobId           String?
  leadId          String?
  waitlistId      String?
  providerId      String?
  error           String?
  sentAt          DateTime?
  notificationKey String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  job             Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([status])
  @@index([jobId])
  @@index([recipient])
}

model JobRatingToken {
  id              String    @id @default(cuid())
  jobId           String
  token           String    @unique
  cleanerId       String?
  customerId      String?
  usedAt          DateTime?
  ratingStars     Int?
  ratherNotAnswer Boolean   @default(false)
  emailSentAt     DateTime?
  popupShownAt    DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([token])
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @default("FIXED") // FIXED | PERCENT
  discountValue Float
  maxUses       Int?
  usesCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code])
}

// Unified activity / audit log — one row per notable system event (email, SMS,
// payment, refund, etc.) with a common shape so the admin Logs page can show
// successes and failures across the whole system in one timeline.
model ActivityLog {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())
  category   ActivityCategory
  action     String
  status     ActivityStatus   @default(SUCCESS)
  actorId    String? // user who triggered it (null = system/anonymous)
  actorLabel String? // denormalized name/email for display
  targetType String? // e.g. "job", "client", "giftCard"
  targetId   String?
  message    String?
  error      String?
  amount     Float?
  providerId String? // Stripe PI / Twilio SID / Resend id
  metadata   Json?

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

enum ActivityCategory {
  EMAIL
  SMS
  PAYMENT
  REFUND
  DEPOSIT
  WEBHOOK
  AUTH
  BOOKING
  ADMIN
  CRON
  SYSTEM
}

enum ActivityStatus {
  SUCCESS
  FAILED
  PENDING
  SKIPPED
}

// Idempotency ledger for Stripe webhooks. The Stripe event id is the primary
// key, so a duplicate delivery collides and is skipped. A row is inserted
// before processing and deleted if processing fails (so Stripe's retry can
// reprocess it).
model WebhookEvent {
  id        String   @id // Stripe event id (evt_...)
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
