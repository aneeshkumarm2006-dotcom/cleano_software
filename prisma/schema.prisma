// Audit trail for every inventory count change (admin warehouse stock OR a
// cleaner's assigned stock). One row per adjustment: item, delta, reason, who,
// when — surfaced on the redesigned inventory page.
model InventoryChange {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String           @default("")
  id             String           @id @default(cuid())
  productId      String
  // Set when the change is to a specific cleaner's inventory; null = warehouse.
  employeeId     String?
  employeeName   String?
  quantityChange Float
  newQuantity    Float
  unit           String?
  reason         String?
  // WHAT this row records, written by the action that performed the movement.
  // Retires the reason-string pattern matching the activity log used to do
  // (Stage 3). Nullable because every row written before that migration has no
  // action — back-filling one would bake the very guess we are retiring into
  // the permanent record, so old rows keep their prose and are labelled as
  // derived at read time (`src/lib/inventory-action.ts`).
  action         InventoryAction?
  // Status transition, when this row records one (PDF #1 wants history to carry
  // "previous status → new status" alongside the count columns above). Stored as
  // free text rather than an enum because one table logs three different status
  // vocabularies — LiquidLevel, EquipmentCondition, and the countable
  // OK/LOW/EMPTY/MISSING/DAMAGED chips.
  previousStatus String?
  newStatus      String?
  changedById    String?
  changedByName  String?
  createdAt      DateTime         @default(now())
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([employeeId])
  @@index([organizationId])
}

/// Admin review/restock flag (PDF #1/#2). Deliberately NOT an InventoryRequest:
/// that model is an APPROVAL queue with its own status machine and is already
/// flooded with auto-created rows. A flag is "someone should look at this",
/// which is a different thing from "please approve N units".
model InventoryFlag {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String              @default("")
  id             String              @id @default(cuid())
  type           InventoryFlagType
  status         InventoryFlagStatus @default(OPEN)
  employeeId     String
  productId      String
  jobId          String? // set when raised at clock-out
  source         String // "CLOCK_OUT" | "RECOUNT" | "ISSUE_REPORT" | "ADMIN"
  notes          String?
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  employee       User                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  job            Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([employeeId])
  @@index([productId])
  @@index([organizationId])
}

model EmployeeProduct {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId  String              @default("")
  id              String              @id @default(cuid())
  employeeId      String
  productId       String
  quantity        Float
  assignedAt      DateTime            @default(now())
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  // Latest status the cleaner reported for this kit row. Which column is
  // meaningful depends on the product's ItemType: `levelStatus` for LIQUID,
  // `quantity` (above) for COUNTABLE_CONSUMABLE, `condition` for
  // REUSABLE_EQUIPMENT. All nullable — "never reported yet" is a real state and
  // must not be confused with "reported as full/available".
  levelStatus     LiquidLevel?
  condition       EquipmentCondition?
  statusUpdatedAt DateTime?
  statusNotes     String?
  employee        User                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([employeeId, productId])
  @@index([employeeId])
  @@index([productId])
  @@index([organizationId])
}

