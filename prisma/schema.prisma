// Job-specific chat thread between the assigned cleaner and the client (admin
// can view/moderate). Keyed by jobId — the job IS the thread. In-app both sides
// (client uses the customer portal); a Twilio SMS bridge can be layered later.
model JobChatMessage {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId   String            @default("")
  id               String            @id @default(cuid())
  jobId            String
  senderId         String?
  senderRole       JobChatSenderRole
  senderName       String
  body             String            @db.Text
  // Photo attachment (CLN-P0-3-05). One per message — a second photo is a
  // second message, which is how every chat product behaves and avoids adding
  // another cascade edge to the job. NULL = text-only, so every existing row
  // is unchanged. `body` stays NOT NULL: a photo-only message stores "", which
  // JobChatThread already renders correctly (it guards `{m.body && …}`).
  // Dimensions come back free from the Cloudinary upload and let the thread
  // reserve the image's box, so a 4s poll + auto-scroll doesn't jump.
  attachmentUrl    String?
  attachmentWidth  Int?
  attachmentHeight Int?
  // Admin moderation (CLN-P0-3-17). Named hiddenAt, not deletedAt: the
  // requirement is "hide … while preserving the original in audit history", and
  // a column called deletedAt invites a future cleanup job to hard-delete the
  // row. `body` and `attachmentUrl` are never rewritten — that IS the
  // preservation — and the hide action also copies the original text into
  // ActivityLog, which has no FK to Job and therefore survives a permanent job
  // delete. Hidden messages are invisible to the cleaner and the client and
  // visible, marked, to admins. hiddenById is a soft reference, matching
  // senderId's existing convention on this table.
  hiddenAt         DateTime?
  hiddenById       String?
  readByAdminAt    DateTime?
  readByClientAt   DateTime?
  readByCleanerAt  DateTime?
  createdAt        DateTime          @default(now())
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([organizationId])
}

