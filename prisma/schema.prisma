  questionFr     String?       @db.Text
  answerFr       String?       @db.Text
  // Defaults chosen so a migrated JSON entry behaves exactly as it did before:
  // published, on both surfaces, with no admin action required.
  status         FaqStatus     @default(PUBLISHED)
  visibility     FaqVisibility @default(BOTH)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       FaqCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  events         FaqEvent[]

  @@index([status, visibility])
  @@index([categoryId, sortOrder])
  @@index([organizationId])
}

/**
 * FAQ analytics (CLN-P1-4-17). The requirement asks for four things and two of
 * them are the same signal on an accordion, which this records rather than
 * inventing a distinction:
 * most-viewed questions   → OPEN   ┐ identical: a question is only ever
 * questions opened most   → OPEN   ┘ "viewed" by being expanded
 * popular searches        → SEARCH (debounced, so one search is one row)
 * searches with no result → SEARCH_NO_RESULT
 * VIEW is one row per FAQ page load (faqId NULL) and exists as the denominator
 * — "40 opens across 300 visits" says something "40 opens" does not.
 * ⚠️ The public page must be able to write here, so the action behind this is
 * unauthenticated and unmetered — the same gap as /api/stripe/charge-deposit
 * and lead/quote submission. Flagged, not silently patched: rate limiting is a
 * separate ticket, and fixing it here alone would imply the money endpoints
 * were covered too.
 */
enum FaqEventType {
  VIEW
  OPEN
  SEARCH
  SEARCH_NO_RESULT
}

model FaqEvent {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String       @default("")
  id             String       @id @default(cuid())
  type           FaqEventType
  // SetNull, not Cascade: deleting a question must not rewrite history and
  // erase the traffic it once had.
  faqId          String?
  // Normalised search term (lowercased, trimmed, capped) for SEARCH events.
  query          String?
  /// "public" | "portal"
  surface        String
  createdAt      DateTime     @default(now())
  faq            Faq?         @relation(fields: [faqId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([faqId, type])
  @@index([query])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Multi-tenancy (Awer platform)
// ---------------------------------------------------------------------------

// One customer of Awer — a cleaning company. Every business row in this schema
// carries organizationId pointing here. TeamCleano is the first, backfilled
// from the single-tenant data this database started as.
//
// Deliberately NOT declared as a Prisma relation on the 97 scoped models: that
// would need a foreign key on every table, and adding 97 FK constraints to a
// live database means validating every existing row. A plain indexed column is
// a pure ADD COLUMN — instant, no table rewrite — and isolation is enforced by
// row-level security rather than by referential integrity.
model Organization {
  id String @id @default(cuid())

  // Subdomain label: "teamcleano" serves teamcleano.useawer.com. Lowercase,
  // hyphen-separated, and reserved words are rejected at the application layer.
  slug String @unique
  name String

  status OrgStatus @default(PENDING)
  plan   OrgPlan   @default(STARTER)

  // Replaces the single NEXT_PUBLIC_BUSINESS_TIMEZONE env var, which could only
  // ever describe one company.
  timezone String @default("America/Toronto")

  /// Next job number to hand out. Allocated atomically -- see allocateJobNumber().
  nextJobNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum OrgStatus {
  PENDING // signed up or requested access, not yet provisioned
  ACTIVE
  SUSPENDED // non-payment or admin action; data retained, access blocked
  CANCELLED
}

enum OrgPlan {
  STARTER
  PROFESSIONAL
  ORGANIZATION // request-access tier
}
