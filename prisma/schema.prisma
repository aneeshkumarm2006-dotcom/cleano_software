generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                 @id @default(cuid())
  name                         String
  email                        String                 @unique
  image                        String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  phone                        String?
  role                         Roles                  @default(EMPLOYEE)
  // Payroll tier — set manually by admin, never auto-changed. Drives the
  // individual pay rate used by the split-job calculation (see src/lib/pay-tiers.ts):
  // Trainee = 30%, Standard = 40–45% (rating-based after 5 ratings), Field Lead = 46%.
  cleanerTier                  CleanerTier            @default(STANDARD)
  // Group membership — the Field Lead this cleaner reports to. Used for the
  // Field Lead's weekly group-revenue bonus (see src/lib/field-lead-bonus.ts).
  fieldLeadId                  String?
  fieldLead                    User?                  @relation("FieldLeadGroup", fields: [fieldLeadId], references: [id], onDelete: SetNull)
  groupMembers                 User[]                 @relation("FieldLeadGroup")
  emailVerified                Boolean                @default(false)
  // Admin can deactivate a provider/cleaner; deactivated users see the
  // configurable provider.deactivatedMessage instead of the app.
  isActive                     Boolean                @default(true)
  payMultiplier                Float                  @default(1.0)
  multiplierLastRecalculatedAt DateTime?
  // Forces a password change on next login (set on temp-password accounts
  // created by the BookingKoala import). The portal gates on this until the
  // customer sets their own password.
  mustChangePassword           Boolean                @default(false)
  lastSeenAt                   DateTime?
  // Self-wash credit ledger — accumulates as jobs complete; drained when
  // the cleaner claims a wash payout. See /lib/wash for the rules.
  ragCredits                   Int                    @default(0)
  padCredits                   Int                    @default(0)
  washPayouts                  WashPayout[]
  accounts                     Account[]
  assignedProducts             EmployeeProduct[]
  inventoryRequests            InventoryRequest[]
  jobs                         Job[]                  @relation("EmployeeJobs")
  sessions                     Session[]
  cleaningJobs                 Job[]                  @relation("JobCleaners")
  jobInvites                   JobAssignmentInvite[]
  jobLogs                      JobLog[]               @relation("UserJobLogs")
  payouts                      Payout[]
  approvedPeriods              PayPeriod[]            @relation("PayPeriodApprover")
  ragWashes                    RagWash[]
  availabilities               EmployeeAvailability[]
  photos                       JobPhoto[]
  checklists                   JobChecklist[]
  signatures                   DocumentSignature[]
  trainingProgress             TrainingProgress[]
  ratings                      EmployeeRating[]
  withdrawals                  Withdrawal[]
  checkouts                    InventoryCheckout[]
  chatConversation             ChatConversation?      @relation("EmployeeChatConversation")
  sentChatMessages             ChatMessage[]          @relation("ChatMessageSender")
  employeeComplaints           Complaint[]            @relation("EmployeeComplaints")
  resolvedComplaints           Complaint[]            @relation("ResolvedComplaints")
  receivedAlerts               Alert[]                @relation("RecipientAlerts")
  strikes                      CleanerStrike[]        @relation("CleanerStrikes")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accessToken  String?
  accountId    String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  idToken      String?
  password     String?
  providerId   String
  refreshToken String?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  token     String   @unique
  updatedAt DateTime @updatedAt
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id                String                   @id @default(cuid())
  name              String
  description       String?
  unit              String
  costPerUnit       Float
  stockLevel        Float                    @default(0)
  minStock          Float                    @default(0)
  category          ProductCategory          @default(OTHER)
  // Stock-count audit trail — who last edited the count and when. Denormalized
  // name so the inventory screen can show "Updated by" without a join.
  stockUpdatedAt    DateTime?
  stockUpdatedById  String?
  stockUpdatedByName String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  employeeProducts  EmployeeProduct[]
  inventoryRequests InventoryRequest[]
  jobUsage          JobProductUsage[]
  kitItems          KitTemplateItem[]
  inventoryRule     InventoryRule?
  supplierPrices    SupplierPrice[]
  locationStock     InventoryLocationStock[]
  checkoutItems     InventoryCheckoutItem[]
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  category  String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model KitTemplate {
  id                String             @id @default(cuid())
  name              String
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             KitTemplateItem[]
  inventoryRequests InventoryRequest[]
}

model KitTemplateItem {
  id            String      @id @default(cuid())
  kitTemplateId String
  productId     String
  quantity      Float
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  kitTemplate   KitTemplate @relation(fields: [kitTemplateId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([kitTemplateId, productId])
  @@index([kitTemplateId])
  @@index([productId])
}

model InventoryRule {
  id              String   @id @default(cuid())
  productId       String   @unique
  usagePerJob     Float    @default(0)
  refillThreshold Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Supplier {
  id        String          @id @default(cuid())
  name      String
  // Suppliers are treated as websites: the primary identifier is the store URL
  // that admin compares prices across. contact/email/phone/address are legacy
  // optional fields kept for backward compatibility.
  website   String?
  contact   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  prices    SupplierPrice[]
}

model SupplierPrice {
  id         String   @id @default(cuid())
  supplierId String
  productId  String
  price      Float
  unit       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
}

model Client {
  id                     String                  @id @default(cuid())
  name                   String
  email                  String?
  secondaryEmail         String?
  phone                  String?
  secondaryPhone         String?
  company                String?
  address                String?
  aptNumber              String?
  city                   String?
  state                  String?
  zip                    String?
  notes                  String?
  discountPercent        Float                   @default(0)
  clientType             ClientType              @default(RESIDENTIAL)
  serviceFrequency       ServiceFrequency?
  isActive               Boolean                 @default(true)
  stripeCustomerId       String?                 @unique
  defaultPaymentMethodId String?
  referralCode           String?                 @unique
  referralCredit         Float                   @default(0)
  giftCardBalance        Float                   @default(0)
  noShowCount            Int                     @default(0)
  lastNoShowAt           DateTime?
  referredByClientId     String?
  userId                 String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  jobs                   Job[]
  invoices               Invoice[]
  complaints             Complaint[]
  waitlistEntries        Waitlist[]
  addresses              ClientAddress[]
  recurringCancellations RecurringCancellation[]
  referredBy             Client?                 @relation("ClientReferrals", fields: [referredByClientId], references: [id], onDelete: SetNull)
  referrals              Client[]                @relation("ClientReferrals")
  contact                Contact?

  @@index([clientType])
  @@index([isActive])
  @@index([referredByClientId])
}

/// Recurring-service cancellation + save-offer tracking. Created only when a
/// customer cancels their ENTIRE recurring service (not a single cleaning).
model RecurringCancellation {
  id            String    @id @default(cuid())
  clientId      String
  frequency     String?
  reason        String?
  cancelledAt   DateTime  @default(now())
  emailSentAt   DateTime?
  offerType     String? // PERCENT | FIXED
  offerValue    Float?
  offerCode     String?
  // PENDING | SENT | OPENED | CLICKED | REPLIED | REDEEMED | EXPIRED | NONE
  offerStatus   String    @default("PENDING")
  openedAt      DateTime?
  clickedAt     DateTime?
  repliedAt     DateTime?
  reactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([offerStatus])
  @@index([cancelledAt])
}

model ClientAddress {
  id        String   @id @default(cuid())
  clientId  String
  label     String   @default("Home")
  address   String
  aptNumber String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
}

enum ServiceFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

model Job {
  id                             String                @id @default(cuid())
  jobNumber                      Int                   @unique @default(autoincrement())
  employeeId                     String?
  clientName                     String
  clientId                       String?
  location                       String?
  aptNumber                      String?
  description                    String?
  jobType                        String?
  jobDate                        DateTime?
  startTime                      DateTime
  endTime                        DateTime?
  clockInTime                    DateTime?
  clockOutTime                   DateTime?
  status                         JobStatus             @default(CREATED)
  price                          Float?
  employeePay                    Float?
  totalTip                       Float?
  parking                        Float?
  paymentReceived                Boolean               @default(false)
  invoiceSent                    Boolean               @default(false)
  notes                          String?
  paymentType                    PaymentType?
  discountAmount                 Float?
  bedCount                       Int?
  bathCount                      Int?
  payRateMultiplier              Float?                @default(1.0)
  isFlexible                     Boolean               @default(false)
  requiredCleaners               Int                   @default(1)
  subtotalAmount                 Float                 @default(0)
  gstAmount                      Float                 @default(0)
  qstAmount                      Float                 @default(0)
  tipAmount                      Float                 @default(0)
  totalAmount                    Float                 @default(0)
  stripeSetupIntentId            String?
  stripePaymentIntentId          String?
  depositPaymentIntentId         String?
  depositPaid                    Boolean               @default(false)
  depositPaidAt                  DateTime?
  paymentFailedAt                DateTime?
  paymentFailureReason           String?
  paidAt                         DateTime?
  refundedAmount                 Float                 @default(0)
  isCashJob                      Boolean               @default(false)
  appliedPromoCode               String?
  promoDiscountAmount            Float?
  // Calendar priority badge override. null = follow the auto rule
  // (calendar.jobTypeLabels setting, keyed by jobType); "ROUTINE" | "IMPORTANT"
  // | "NONE" = an operations manager's explicit switch on the job detail page.
  priorityLabel                  String?
  cancellationRequestedAt        DateTime?
  // Customer-facing cancellation reason (shown in the portal, visible to both
  // admin and customer). Distinct from internal NOTE_ADDED audit logs.
  cancellationReason             String?
  // Late-cancellation fee charged to the saved card when the customer
  // cancels within the 48h window (see CANCELLATION_FEE_USD in policy.ts).
  // `cancellationFeeChargedAt` makes the charge idempotent.
  cancellationFeeChargedAt       DateTime?
  cancellationFeePaymentIntentId String?
  rescheduleRequestedAt          DateTime?
  parentJobId                    String?
  bookingSource                  String?
  // External source's unique booking id (e.g. BookingKoala "Booking id") — the
  // idempotency key for imports, so concurrent same-time jobs aren't deduped away.
  externalBookingId              String?
  squareFootage                  Int?
  halfBathCount                  Int?
  // Rag-wash projection — computed from job specs at completion.
  // `washCreditsAwarded` flips to true once credits are written to
  // the assigned cleaner ledger(s), making the award idempotent.
  washProjectedRags              Int?
  washProjectedPads              Int?
  washCappedRags                 Int?
  washCappedPads                 Int?
  washActualRags                 Int?
  washActualPads                 Int?
  washCreditsAwarded             Boolean               @default(false)
  // "On My Way" — set when the cleaner presses On My Way before clocking in.
  // Visible to admin; triggers the customer on-the-way notification. Clock-in
  // is still separate. onMyWayLat/Lng capture the cleaner's location at press
  // time (optional, only when the cleaner grants geolocation) for live ETA.
  onMyWayAt                      DateTime?
  onMyWayLat                     Float?
  onMyWayLng                     Float?
  onMyWayLocationAt              DateTime?
  // No-show + late-arrival event timestamps (admin action + clock-in watcher).
  noShowAt                       DateTime?
  lateArrivalAt                  DateTime?
  // Stars deducted from this job's customer rating because the cleaner arrived
  // late (flat −0.5 past the 10-min grace; see src/lib/policy.ts). Column name
  // kept as the legacy "lateArrivalRatingCap" to avoid a migration.
  lateArrivalRatingPenalty       Float?                @map("lateArrivalRatingCap")
  // Manager override for the Rag Wash review flag.
  washReviewOverrideAt           DateTime?
  washReviewOverrideBy           String?
  // Card hold lifecycle. `holdPaymentIntentId` is set when admin (or the
  // booking flow) places a manual-capture PI for the full job price.
  holdPaymentIntentId            String?
  holdPlacedAt                   DateTime?
  holdAmount                     Float?
  holdCapturedAt                 DateTime?
  holdReleasedAt                 DateTime?
  holdCaptureFailedAt            DateTime?
  holdCaptureFailReason          String?
  // After-photo consent captured at booking time. `afterPhotoOverrideAt`
  // lets admin authorise after-photos for a job even without consent.
  afterPhotoConsent              Boolean               @default(false)
  afterPhotoConsentAt            DateTime?
  afterPhotoConsentVersion       String?
  afterPhotoOverrideAt           DateTime?
  // SMS notification consent captured at booking time (default checked, admin
  // setting customer.smsOptInDefault). Existing rows default to true.
  smsConsent                     Boolean               @default(true)
  afterPhotoOverrideBy           String?
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt
  employee                       User?                 @relation("EmployeeJobs", fields: [employeeId], references: [id], onDelete: SetNull)
  client                         Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  parentJob                      Job?                  @relation("JobRecurrence", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs                      Job[]                 @relation("JobRecurrence")
  productUsage                   JobProductUsage[]
  cleaners                       User[]                @relation("JobCleaners")
  assignmentInvites              JobAssignmentInvite[]
  logs                           JobLog[]
  addOns                         JobAddOn[]
  transactions                   Transaction[]
  invoices                       Invoice[]
  photos                         JobPhoto[]
  reviewPhotos                   ReviewPhoto[]
  chatMessages                   JobChatMessage[]
  checklists                     JobChecklist[]
  ratings                        EmployeeRating[]
  complaints                     Complaint[]
  emailLogs                      EmailLog[]
  ratingTokens                   JobRatingToken[]
  strikes                        CleanerStrike[]
  convertedFromLeads             Lead[]
  convertedFromWaitlist          Waitlist[]

  @@index([jobDate])
  @@index([clientName])
  @@index([clientId])
  @@index([status])
  @@index([parentJobId])
  @@index([isFlexible])
  @@index([externalBookingId])
}

model JobAddOn {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model PricingRule {
  id        String   @id @default(cuid())
  bedCount  Int
  bathCount Int
  basePrice Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bedCount, bathCount])
}

model JobProductUsage {
  id              String   @id @default(cuid())
  jobId           String
  productId       String
  quantity        Float
  inventoryBefore Float?
  inventoryAfter  Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([jobId, productId])
}

model JobLog {
  id          String       @id @default(cuid())
  jobId       String
  userId      String?
  action      JobLogAction
  field       String?
  oldValue    String?
  newValue    String?
  description String
  createdAt   DateTime     @default(now())
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User?        @relation("UserJobLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([createdAt])
  @@index([userId])
}

model InventoryRequest {
  id          String        @id @default(cuid())
  employeeId  String
  productId   String?
  kitId       String?
  quantity    Float
  reason      String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  employee    User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  kitTemplate KitTemplate?  @relation(fields: [kitId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([productId])
  @@index([kitId])
}

model EmployeeProduct {
  id         String   @id @default(cuid())
  employeeId String
  productId  String
  quantity   Float
  assignedAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([employeeId, productId])
  @@index([employeeId])
  @@index([productId])
}

model PayPeriod {
  id           String          @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  status       PayPeriodStatus @default(DRAFT)
  notes        String?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  approvedBy   User?           @relation("PayPeriodApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  payouts      Payout[]

  @@index([startDate])
  @@index([status])
}

model Payout {
  id             String    @id @default(cuid())
  payPeriodId    String
  employeeId     String
  baseAmount     Float     @default(0)
  adjustments    Float     @default(0)
  deductions     Float     @default(0)
  reimbursements Float     @default(0)
  finalAmount    Float     @default(0)
  jobCount       Int       @default(0)
  totalHours     Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payPeriod      PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  employee       User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payPeriodId, employeeId])
  @@index([payPeriodId])
  @@index([employeeId])
}

model Transaction {
  id          String              @id @default(cuid())
  date        DateTime            @default(now())
  category    TransactionCategory
  amount      Float
  description String?
  notes       String?
  jobId       String?
  source      String?
  taxAmount   Float               @default(0)
  isAuto      Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  job         Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
  @@index([jobId])
}

model RagWash {
  id         String   @id @default(cuid())
  employeeId String
  washDate   DateTime @default(now())
  ragCount   Int      @default(0)
  padCount   Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([washDate])
}

// Per-spec rag-wash credit-to-cash redemption. Records every payout drain.
model WashPayout {
  id               String           @id @default(cuid())
  employeeId       String
  ragCreditsUsed   Int              @default(0)
  padCreditsUsed   Int              @default(0)
  amount           Float
  status           WashPayoutStatus @default(PENDING)
  stripeTransferId String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  employee         User             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
}

enum WashPayoutStatus {
  PENDING
  COMPLETED
  FAILED
}

model Budget {
  id        String              @id @default(cuid())
  category  TransactionCategory
  period    String
  amount    Float
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([category, period])
  @@index([period])
}

enum Roles {
  OWNER
  ADMIN
  OPS_MANAGER
  FIELD_LEAD
  EMPLOYEE
  CLIENT
}

// Payroll tier for a cleaner. Distinct from Roles (access control): a Field Lead
// tier cleaner may still hold the FIELD_LEAD access role for their manager login.
enum CleanerTier {
  TRAINEE
  STANDARD
  FIELD_LEAD
}

enum ProductCategory {
  LIQUID_SPRAY
  MOP_LIQUID
  DISPOSABLE
  OTHER
}

enum NotificationRecipient {
  ADMIN
  CUSTOMER
  PROVIDER
}

enum NotificationChannel {
  EMAIL
  SMS
  APP_PUSH
}

// Catalog of every notification the system can emit, with per-recipient,
// per-channel enabled flag. Seeded from the Notification Catalog spec; admin
// can toggle any row from Settings → Notifications.
model NotificationSetting {
  id         String                @id @default(cuid())
  recipient  NotificationRecipient
  category   String
  key        String
  label      String
  trigger    String
  channel    NotificationChannel
  enabled    Boolean               @default(false)
  isProposed Boolean               @default(false)
  sortOrder  Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([recipient, key, channel])
  @@index([recipient])
  @@index([category])
}

enum JobStatus {
  CREATED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  PAID
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum JobLogAction {
  CREATED
  UPDATED
  CLOCKED_IN
  CLOCKED_OUT
  STATUS_CHANGED
  PAYMENT_RECEIVED
  INVOICE_SENT
  PRODUCT_USED
  NOTE_ADDED
  CLEANER_ADDED
  CLEANER_REMOVED
}

enum PaymentType {
  CASH
  CHEQUE
  E_TRANSFER
  CREDIT_CARD
  OTHER
}

enum PayPeriodStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum TransactionCategory {
  REVENUE
  SUPPLIES
  LABOUR
  OVERHEAD
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String            @id @default(cuid())
  invoiceNumber  String            @unique
  status         InvoiceStatus     @default(DRAFT)
  clientId       String
  jobId          String?
  subtotal       Float             @default(0)
  gstAmount      Float             @default(0)
  qstAmount      Float             @default(0)
  discountAmount Float             @default(0)
  totalAmount    Float             @default(0)
  paidAmount     Float             @default(0)
  notes          String?
  dueDate        DateTime?
  sentAt         DateTime?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  job            Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lineItems      InvoiceLineItem[]

  @@index([clientId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  amount      Float    @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Alert {
  id              String        @id @default(cuid())
  type            AlertType
  severity        AlertSeverity @default(WARNING)
  title           String
  message         String
  isRead          Boolean       @default(false)
  isDismissed     Boolean       @default(false)
  relatedId       String?
  relatedType     String?
  recipientUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  recipient       User?         @relation("RecipientAlerts", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([recipientUserId])
}

model Target {
  id          String       @id @default(cuid())
  metric      TargetMetric
  period      TargetPeriod
  periodStart DateTime
  targetValue Float
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([metric, period, periodStart])
  @@index([periodStart])
}

model AlertRoutingRule {
  id                 String         @id @default(cuid())
  alertType          AlertType
  recipientRole      Roles
  isActive           Boolean        @default(true)
  frequency          AlertFrequency @default(IMMEDIATE)
  escalateToRole     Roles?
  escalateAfterHours Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([alertType, recipientRole])
  @@index([alertType])
  @@index([recipientRole])
}

enum AlertFrequency {
  IMMEDIATE
  HOURLY_DIGEST
  DAILY_DIGEST
}

model Complaint {
  id           String            @id @default(cuid())
  jobId        String?
  clientId     String?
  employeeId   String?
  resolvedById String?
  category     ComplaintCategory
  priority     ComplaintPriority @default(MEDIUM)
  details      String            @db.Text
  status       ComplaintStatus   @default(OPEN)
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  job          Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  employee     User?             @relation("EmployeeComplaints", fields: [employeeId], references: [id], onDelete: SetNull)
  resolvedBy   User?             @relation("ResolvedComplaints", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([clientId])
  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
}

enum ComplaintCategory {
  SERVICE_QUALITY
  BEHAVIOR
  DAMAGE
  MISSED_APPOINTMENT
  BILLING
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum AlertType {
  LOW_INVENTORY
  CANCELLATION
  OVERDUE_PAYMENT
  PROVIDER_LOW_STOCK
  CLEANER_PAYMENT
  IMMEDIATE_PAYOUT
  CLIENT_COMPLAINT
  RATING_DECREASE
  OVERDUE_COMMERCIAL
  CLEANER_STRIKE
  GENERAL
}

/// Three-strike accountability. Strikes roll off 30 days after they're
/// applied (rolling window) — `expiresAt` is that reset date. Excused /
/// removed strikes stop counting immediately. Active = ACTIVE + expiresAt > now.
enum StrikeReason {
  LATE_45
  NO_SHOW
  LOW_RATINGS_CONSECUTIVE
  REFUND_COMPLAINT
  LATE_CANCEL
  JOB_ABANDONMENT
  FALSIFIED_CLOCK
  CHECKLIST_FAILURE
  UNAPPROVED_PERSON
  MISCONDUCT
  MANUAL
}

enum StrikeStatus {
  ACTIVE
  EXPIRED
  EXCUSED
  REMOVED
}

model CleanerStrike {
  id          String       @id @default(cuid())
  cleanerId   String
  reasonCode  StrikeReason
  reason      String
  jobId       String?
  status      StrikeStatus @default(ACTIVE)
  isAuto      Boolean      @default(true)
  appliedById String?
  adminNote   String?
  excusedById String?
  excusedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cleaner     User         @relation("CleanerStrikes", fields: [cleanerId], references: [id], onDelete: Cascade)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([cleanerId])
  @@index([status])
  @@index([jobId])
  @@index([expiresAt])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TargetMetric {
  REVENUE
  JOBS_COMPLETED
  NEW_CLIENTS
  PROFIT_MARGIN
  AVG_JOB_PRICE
  EMPLOYEE_RETENTION
}

enum TargetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

