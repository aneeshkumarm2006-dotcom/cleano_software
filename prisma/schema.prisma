model ChecklistTemplate {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId  String  @default("")
  id              String  @id @default(cuid())
  name            String
  jobType         String?
  addOnName       String?
  description     String?
  /// Customer / contract scoping (PDF #10, Stage 10). NULL = not scoped to a
  /// customer, which is every template written before this column and is what
  /// keeps the old jobType/add-on matching working untouched.
  ///
  /// When set, the template applies ONLY to that client's jobs — and it
  /// OVERRIDES the service-type default rather than stacking on top of it
  /// ("every Mckiernan job gets the strict Mckiernan checklist"). The
  /// precedence lives in one place: `resolveChecklistTemplates()` in
  /// src/lib/checklist-triggers.ts.
  ///
  /// onDelete: Cascade — a client-scoped template is worthless without its
  /// client, and SetNull would be actively dangerous: it would silently promote
  /// a strict customer checklist into a GLOBAL one that fires on every job in
  /// the business. `deleteClient` already refuses while any job is linked, so
  /// this only ever fires for a client with no history.
  clientId        String?
  /// Narrower still: one LOCATION of that client. Always stored alongside
  /// `clientId` (the editor and both actions enforce it), which is what makes
  /// onDelete: SetNull safe here — deleting the address degrades the template
  /// from "Mckiernan — 12 Main St" to "Mckiernan — all locations" instead of
  /// making it global.
  clientAddressId String?

  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  items         ChecklistTemplateItem[]
  jobChecklists JobChecklist[]
  client        Client?                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientAddress ClientAddress?          @relation(fields: [clientAddressId], references: [id], onDelete: SetNull)
  /// Jobs that pin this template explicitly (`Job.checklistTemplateId`).
  pinnedJobs    Job[]                   @relation("JobChecklistTemplate")

  @@index([clientId])
  @@index([clientAddressId])
  @@index([organizationId])
}

