enum JobCleanerStatus {
  ASSIGNED
  ON_THE_WAY
  CLOCKED_IN
  CLOCKED_OUT
  COMPLETED
  CANCELLED
}

// Per-cleaner live status + pay for a job. Complements the implicit
// Job.cleaners M2M ("JobCleaners") — one row per cleaner per job, upserted on
// assignment and updated by the cleaner clock actions. The job-level
// clockInTime/clockOutTime/onMyWayAt stay as the legacy/first-cleaner fields.
model JobAssignment {
  id           String           @id @default(cuid())
  jobId        String
  cleanerId    String
  status       JobCleanerStatus @default(ASSIGNED)
  onMyWayAt    DateTime?
  clockInTime  DateTime?
  clockOutTime DateTime?
  // This cleaner's pay for this job (same proportional-split math as payroll).
  payAmount    Float?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner      User             @relation("CleanerAssignments", fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([jobId, cleanerId])
  @@index([cleanerId])
}

/// A break/pause taken by ONE cleaner during ONE job (awer_fixes.pdf item 26).
///
/// Modelled as ROWS rather than a start/end column pair on JobAssignment so a
/// cleaner can take more than one break in a shift — which is normal on a long
/// job, and a single pair would silently overwrite the earlier break.
/// `endedAt` null = the break is currently running.
model JobBreak {
  id        String    @id @default(cuid())
  jobId     String
  cleanerId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner   User      @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([jobId, cleanerId])
  @@index([cleanerId])
}

model JobAssignmentInvite {
  id            String            @id @default(cuid())
  jobId         String
  cleanerId     String
  decision      JobInviteDecision @default(PENDING)
  sentAt        DateTime          @default(now())
  respondedAt   DateTime?
  expiresAt     DateTime
  declineReason String?
  // If true, this invite was created as part of a last-minute reposting
  // and the cleaner who accepts earns the configured bonus.
  isLastMinute  Boolean           @default(false)
  bonusUsd      Float             @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner       User              @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([jobId, cleanerId])
  @@index([cleanerId, decision])
  @@index([expiresAt])
}

