  // Personal information
  name              String // combined "First Last", kept for display/avatars
  firstName         String?
  lastName          String?
  gender            String?
  dateOfBirth       String? // "YYYY-MM-DD"
  email             String
  phone             String?
  addressStreet     String?
  addressLine2      String?
  cityArea          String? // City
  province          String? // State / Province
  postalCode        String?
  country           String?
  // Transportation
  hasTransport      Boolean? // reliable vehicle
  driversLicense    String?
  hasInsurance      Boolean?
  insuranceDetails  String?
  // Availability
  availability      String? // legacy / readable summary
  availableDays     String[]             @default([])
  preferredHours    String?
  earliestStart     String? // "YYYY-MM-DD"
  // Experience
  yearsExperience   String?
  experienceTypes   String[]             @default([])
  experience        String? // free-text description
  resumeUrl         String?
  // About you
  whyCleano         String?
  hasConviction     Boolean?
