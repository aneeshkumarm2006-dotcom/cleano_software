enum AvailabilityDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DocumentStatus {
  PENDING
  SIGNED
  EXPIRED
  REVOKED
}

enum ChecklistItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model EmployeeAvailability {
  id            String          @id @default(cuid())
  employeeId    String
  day           AvailabilityDay
  startTime     String
  endTime       String
  isAvailable   Boolean         @default(true)
  isRecurring   Boolean         @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  employee      User            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, day])
  @@index([employeeId])
}

// One-off date blocks (vacation, appointment, sick day) layered ON TOP of the
// recurring weekly EmployeeAvailability. EmployeeAvailability is unique per
// (employee, weekday) so it can't express "this specific Monday is off" —
// that's what this is for. A row = the cleaner is unavailable that date.
model AvailabilityException {
  id         String   @id @default(cuid())
  employeeId String
  // Date-only (midnight, business timezone) — the blocked day.
  date       DateTime
  reason     String?
  createdAt  DateTime @default(now())
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

model JobPhoto {
  id         String   @id @default(cuid())
  jobId      String
  employeeId String
  url        String
  caption    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([employeeId])
}

enum JobChatSenderRole {
  CLEANER
  CLIENT
  ADMIN
}

// Job-specific chat thread between the assigned cleaner and the client (admin
// can view/moderate). Keyed by jobId — the job IS the thread. In-app both sides
// (client uses the customer portal); a Twilio SMS bridge can be layered later.
model JobChatMessage {
  id               String            @id @default(cuid())
  jobId            String
  senderId         String?
  senderRole       JobChatSenderRole
  senderName       String
  body             String            @db.Text
  // Photo attachment (CLN-P0-3-05). One per message — a second photo is a
  // second message, which is how every chat product behaves and avoids adding
  // another cascade edge to the job. NULL = text-only, so every existing row
  // is unchanged. `body` stays NOT NULL: a photo-only message stores "", which
  // JobChatThread already renders correctly (it guards `{m.body && …}`).
  // Dimensions come back free from the Cloudinary upload and let the thread
  // reserve the image's box, so a 4s poll + auto-scroll doesn't jump.
  attachmentUrl    String?
  attachmentWidth  Int?
  attachmentHeight Int?
  readByAdminAt    DateTime?
  readByClientAt   DateTime?
  readByCleanerAt  DateTime?
  createdAt        DateTime          @default(now())
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

// Cleaner group chat (spec #15). One default "All cleaners" channel; admin can
// create more and moderate (soft-delete messages). Visible to all cleaners.
model GroupChannel {
  id          String               @id @default(cuid())
  name        String
  isDefault   Boolean              @default(false)
  isActive    Boolean              @default(true)
  // Direct (1:1) cleaner-to-cleaner conversation — exactly two member rows.
  isDirect    Boolean              @default(false)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  messages    GroupMessage[]
  members     GroupChannelMember[]
}

// Channel membership. The default (isDefault) channel has no member rows —
// all staff belong implicitly. Custom channels and DMs list members explicitly.
model GroupChannelMember {
  id        String       @id @default(cuid())
  channelId String
  userId    String
  createdAt DateTime     @default(now())
  channel   GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Announcement {
  id         String                 @id @default(cuid())
  title      String
  body       String                 @db.Text
  pinned     Boolean                @default(false)
  // Denormalized author (same pattern as GroupMessage.senderName).
  authorId   String?
  authorName String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  reactions  AnnouncementReaction[]

  @@index([createdAt])
}

// One reaction per user per announcement (unique constraint) — picking a
// different emoji replaces the previous one; picking the same one removes it.
model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
}

model GroupMessage {
  id         String       @id @default(cuid())
  channelId  String
  senderId   String
  senderName String
  body       String       @db.Text
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())
  channel    GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// Per-user read cursor for a group channel — powers unread badges + read
// receipts in team chat (spec: job chat and team chat track read separately).
model GroupChannelRead {
  id         String   @id @default(cuid())
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

// Photos a CLIENT attaches to a poor review. Distinct from JobPhoto (cleaner
