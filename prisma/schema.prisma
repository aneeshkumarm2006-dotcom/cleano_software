/// "These two are not the same person." Scoped to the PAIR, deliberately —
/// the previous mechanism (`Contact.duplicateDismissed`) flagged whole records,
/// so rejecting one bad suggestion suppressed that contact against every other
/// record forever, including duplicates created months later, with no undo.
/// `contactAId` always holds the lexicographically smaller id so the unique
/// index catches the same pair submitted in either order.
model DuplicateRejection {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String   @default("")
  id             String   @id @default(cuid())
  contactAId     String
  contactBId     String
  rejectedAt     DateTime @default(now())
  rejectedBy     String? // admin display name, snapshot (User rows may be removed)
  contactA       Contact  @relation("DuplicateRejectionA", fields: [contactAId], references: [id], onDelete: Cascade)
  contactB       Contact  @relation("DuplicateRejectionB", fields: [contactBId], references: [id], onDelete: Cascade)

  @@unique([contactAId, contactBId])
  @@index([contactBId])
  @@index([rejectedAt])
  @@index([organizationId])
}

