/**
 * Set-password invite token minted when an admin clicks "Invite to portal"
 * on a JobApplication (decision D4). Same shape and lifecycle as
 * ClientCardSetupToken / JobRatingToken: random token, expiry, single-use
 * via `usedAt`. Consumed on the public /applicant-invite/[token] page, which
 * lets the applicant set their own password — the click-through on an email
 * only they received is what stands in for email verification.
 */
model ApplicantInviteToken {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String    @default("")
  id             String    @id @default(cuid())
  userId         String
  token          String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([organizationId])
}

/**
 * Minimal two-way "respond to requests" channel between admin and an
 * applicant, scoped to one JobApplication. Deliberately separate from
 * JobApplication.notes, which the admin UI already frames as a private,
 * admin-only note and must stay that way.
 */
model ApplicantMessage {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId   String         @default("")
