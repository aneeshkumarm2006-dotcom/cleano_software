// Per-cleaner live status + pay for a job. Complements the implicit
// Job.cleaners M2M ("JobCleaners") — one row per cleaner per job, upserted on
// assignment and updated by the cleaner clock actions. The job-level
// clockInTime/clockOutTime/onMyWayAt stay as the legacy/first-cleaner fields.
model JobAssignment {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String           @default("")
  id             String           @id @default(cuid())
  jobId          String
  cleanerId      String
  status         JobCleanerStatus @default(ASSIGNED)
  onMyWayAt      DateTime?
  clockInTime    DateTime?
  clockOutTime   DateTime?
  // This cleaner's pay for this job (same proportional-split math as payroll).
  payAmount      Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner        User             @relation("CleanerAssignments", fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([jobId, cleanerId])
  @@index([cleanerId])
  @@index([organizationId])
}

/// One clock-in → clock-out stretch for ONE cleaner on ONE job
/// (awerfixes.pdf item 6, round 3 — "clock back into a job").
///
/// Modelled as ROWS for the same reason JobBreak is: a cleaner can legitimately
/// leave and come back — supply run, a second visit the same day, a job that
/// spills past a break in the schedule — and the single
/// clockInTime/clockOutTime pair could only ever hold the last one. Worse, that
/// pair lived on the JOB, so one cleaner clocking in blocked the whole crew and
/// one cleaner clocking out completed the job for everybody.
///
/// `endedAt` null = this session is running right now.
///
/// Keyed on (jobId, cleanerId) rather than a JobAssignment FK on purpose:
/// syncJobAssignments deletes non-CANCELLED assignment rows when an admin takes
/// a cleaner off a job, which would cascade away the record of work they had
/// actually done.
///
/// Job.clockInTime / Job.clockOutTime and the JobAssignment pair are still
/// maintained as derived mirrors, so every legacy reader keeps working and jobs
/// that predate this model still report correctly from the pair alone.
model JobWorkSession {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String    @default("")
  id             String    @id @default(cuid())
  jobId          String
  cleanerId      String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner        User      @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([jobId, cleanerId])
  @@index([cleanerId])
  @@index([organizationId])
}

/// A break/pause taken by ONE cleaner during ONE job (awer_fixes.pdf item 26).
///
/// Modelled as ROWS rather than a start/end column pair on JobAssignment so a
/// cleaner can take more than one break in a shift — which is normal on a long
/// job, and a single pair would silently overwrite the earlier break.
/// `endedAt` null = the break is currently running.
model JobBreak {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String    @default("")
  id             String    @id @default(cuid())
  jobId          String
  cleanerId      String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner        User      @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([jobId, cleanerId])
  @@index([cleanerId])
  @@index([organizationId])
}

model JobAssignmentInvite {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId     String            @default("")
