/// Budget / transaction categories. Was the hard `TransactionCategory` enum
/// until Stage 8 (client item 12) — the five enum values are seeded as
/// `isDefault` rows so existing budgets and bookkeeping history carry over
/// unchanged, and admins can add their own on top from Settings → Budgets.
///
/// `slug` is the STABLE identity used by the automatic writers (Stripe
/// receipts → `revenue`, clock-out supply costs → `supplies`, pay periods →
/// `labour`). It is assigned once at creation and never changes, so renaming a
/// category is purely cosmetic and every historical row follows the new name.
///
/// Deleting a category that has budgets or transactions sets `archivedAt`
/// instead: it disappears from the pickers, history keeps rendering.
model BudgetCategory {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String             @default("")
  id             String             @id @default(cuid())
  name           String
  slug           String
  kind           BudgetCategoryKind @default(EXPENSE)
  isDefault      Boolean            @default(false)
  sortOrder      Int                @default(0)
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  budgets      Budget[]
  transactions Transaction[]

  @@unique([organizationId, slug])
  @@index([archivedAt])
  @@index([sortOrder])
  @@index([organizationId])
}

/// Whether amounts filed under a category count as money in or money out.
/// Every P&L, income-statement and tax figure branches on this — it is what
/// used to be `category === "REVENUE"`.
enum BudgetCategoryKind {
  REVENUE
  EXPENSE
}

enum Roles {
  OWNER
  ADMIN
  OPS_MANAGER
  FIELD_LEAD
  EMPLOYEE
