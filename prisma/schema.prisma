generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId               String                  @default("")
  deletedAt                    DateTime? // soft-delete (recoverable via Archived view)
  id                           String                  @id @default(cuid())
  name                         String
  // Unique per organization, not globally: the same person can be a customer
  // of two cleaning companies, with a separate account at each. better-auth
  // resolves users through the organization-scoped client (see lib/auth.ts),
  // so a lookup only ever sees this organization's users.
  email                        String
  image                        String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  phone                        String?
  role                         Roles                   @default(EMPLOYEE)
  // Payroll tier — set manually by admin, never auto-changed. Drives the
  // individual pay rate used by the split-job calculation (see src/lib/pay-tiers.ts):
  // Trainee = 30%, Standard = 40–45% (rating-based after 5 ratings), Field Lead = 46%.
  cleanerTier                  CleanerTier             @default(STANDARD)
  // Service categories this employee is allowed to work (awerfixes.pdf item 3).
  // EMPTY = ALL allowed, so existing cleaners are unaffected and admins opt IN
  // to restricting someone. Enforced hard on the cleaner side (available jobs,
  // preview, claim); ADVISORY only on the admin side, which can always override.
  // Values are canonical category keys — see src/lib/service-permissions.ts.
  allowedServiceCategories     String[]                @default([])
  // Group membership — the Field Lead this cleaner reports to. Used for the
  // Field Lead's weekly group-revenue bonus (see src/lib/field-lead-bonus.ts).
  fieldLeadId                  String?
  fieldLead                    User?                   @relation("FieldLeadGroup", fields: [fieldLeadId], references: [id], onDelete: SetNull)
  groupMembers                 User[]                  @relation("FieldLeadGroup")
  emailVerified                Boolean                 @default(false)
  // Admin can deactivate a provider/cleaner; deactivated users see the
  // configurable provider.deactivatedMessage instead of the app.
  isActive                     Boolean                 @default(true)
  // This cleaner is blocked from posting in job chat, on every job they are
  // assigned to (CLN-P0-3-14). NULL = allowed. Distinct from isActive, which
  // locks them out of the app entirely.
  chatDisabledAt               DateTime?
  payMultiplier                Float                   @default(1.0)
  multiplierLastRecalculatedAt DateTime?
  // Forces a password change on next login (set on temp-password accounts
  // created by the BookingKoala import). The portal gates on this until the
  // customer sets their own password.
  mustChangePassword           Boolean                 @default(false)
  lastSeenAt                   DateTime?
  // Self-wash credit ledger — accumulates as jobs complete; drained when
  // the cleaner claims a wash payout. See /lib/wash for the rules.
  ragCredits                   Int                     @default(0)
  padCredits                   Int                     @default(0)
  washPayouts                  WashPayout[]
  accounts                     Account[]
  assignedProducts             EmployeeProduct[]
  inventoryFlags               InventoryFlag[]
  inventoryRequests            InventoryRequest[]
  jobs                         Job[]                   @relation("EmployeeJobs")
  sessions                     Session[]
  cleaningJobs                 Job[]                   @relation("JobCleaners")
  jobInvites                   JobAssignmentInvite[]
  jobAssignments               JobAssignment[]         @relation("CleanerAssignments")
  jobBreaks                    JobBreak[]
  jobWorkSessions              JobWorkSession[]
  jobLogs                      JobLog[]                @relation("UserJobLogs")
  payouts                      Payout[]
  approvedPeriods              PayPeriod[]             @relation("PayPeriodApprover")
  ragWashes                    RagWash[]
  availabilities               EmployeeAvailability[]
  availabilityExceptions       AvailabilityException[]
  photos                       JobPhoto[]
  checklists                   JobChecklist[]
  signatures                   DocumentSignature[]
  documentAccessLogs           DocumentAccessLog[]
  trainingProgress             TrainingProgress[]
  ratings                      EmployeeRating[]
  withdrawals                  Withdrawal[]
  checkouts                    InventoryCheckout[]
  chatConversation             ChatConversation?       @relation("EmployeeChatConversation")
  sentChatMessages             ChatMessage[]           @relation("ChatMessageSender")
  employeeComplaints           Complaint[]             @relation("EmployeeComplaints")
  resolvedComplaints           Complaint[]             @relation("ResolvedComplaints")
  receivedAlerts               Alert[]                 @relation("RecipientAlerts")
  strikes                      CleanerStrike[]         @relation("CleanerStrikes")
  files                        EmployeeFile[]
  salesCommissions             Commission[]            @relation("SalesRepCommissions")
  // Applicant portal account (decision D4) — null unless this User was
  // minted via "Invite to portal" from a JobApplication.
  jobApplication               JobApplication?
  applicantInviteTokens        ApplicantInviteToken[]

  @@unique([organizationId, email])
  // Present in the database since an earlier migration but never declared here,
  // which showed up as schema drift. Field-lead grouping reads this column, so
  // the index is kept and declared rather than dropped.
  @@index([fieldLeadId])
  @@index([organizationId])
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accessToken  String?
  accountId    String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  idToken      String?
  password     String?
  providerId   String
  refreshToken String?
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  token     String   @unique
  updatedAt DateTime @updatedAt
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId          String                   @default("")
  deletedAt               DateTime? // soft-delete (recoverable via Archived view)
  id                      String                   @id @default(cuid())
  name                    String
  description             String?
  unit                    String
  costPerUnit             Float
  stockLevel              Float                    @default(0)
  // COMPANY REORDER THRESHOLD — applies to company/locker stock and answers
  // "does Cleano need to buy more?". Named `minStock` for backward
  // compatibility; treat it as the company threshold everywhere.
  minStock                Float                    @default(0)
  // CLEANER RESTOCK THRESHOLD — applies to each cleaner's assigned kit and
  // answers "does this cleaner need topping up?". Deliberately separate from
  // minStock: a warehouse that reorders at 20 bottles has nothing to do with a
  // cleaner who should be topped up at 2 (awer_fixes.pdf item 14).
  // Backfilled from InventoryRule.refillThreshold, which is now read-only legacy.
  cleanerRestockThreshold Float                    @default(0)
  category                ProductCategory          @default(OTHER)
  // WHAT KIND of thing this is (liquid / countable consumable / reusable
  // equipment). Separate from `category`, which only says how usage was logged
  // at clock-out. Every threshold and status rule branches on this one.
  // Default is COUNTABLE_CONSUMABLE so a product created before an admin has
  // thought about it behaves exactly as it does today.
  itemType                ItemType                 @default(COUNTABLE_CONSUMABLE)
  // Stock-count audit trail — who last edited the count and when. Denormalized
  // name so the inventory screen can show "Updated by" without a join.
  stockUpdatedAt          DateTime?
  stockUpdatedById        String?
  stockUpdatedByName      String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  employeeProducts        EmployeeProduct[]
  inventoryRequests       InventoryRequest[]
  jobUsage                JobProductUsage[]
  kitItems                KitTemplateItem[]
  supplierPrices          SupplierPrice[]
  // Exact purchase link for re-ordering this product (the "one link" case).
  // Additional links live in ProductLink.
  purchaseUrl             String?
  locationStock           InventoryLocationStock[]
  checkoutItems           InventoryCheckoutItem[]
  inventoryChanges        InventoryChange[]
  inventoryFlags          InventoryFlag[]
  links                   ProductLink[]

  @@index([organizationId])
}

// Extra purchase links for a product (a product can be bought from several
// places). `purchaseUrl` on Product stays the primary/exact link.
model ProductLink {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String   @default("")
  id             String   @id @default(cuid())
  productId      String
  label          String?
  url            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([organizationId])
}

model AppSetting {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String   @default("")
  id             String   @id @default(cuid())
  key            String
  category       String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([category])
  @@index([organizationId])
}

model KitTemplate {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId    String             @default("")
  id                String             @id @default(cuid())
  name              String
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             KitTemplateItem[]
  inventoryRequests InventoryRequest[]

  @@index([organizationId])
}

model KitTemplateItem {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String      @default("")
  id             String      @id @default(cuid())
  kitTemplateId  String
  productId      String
  quantity       Float
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  kitTemplate    KitTemplate @relation(fields: [kitTemplateId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([kitTemplateId, productId])
  @@index([kitTemplateId])
  @@index([productId])
  @@index([organizationId])
}

// NOTE: `model InventoryRule` stood here until Stage 3 (`_ai_context/TODO.md`).
// It held `usagePerJob` (an admin-typed guess at consumption) and
// `refillThreshold`, both of which awer_fixes.pdf item 20 stopped reading — the
// forecast moved to measured usage and the threshold moved to
// `Product.cleanerRestockThreshold`. It has been dead code since then; the drop
// was held back for a deploy with a backup point, which is this batch.
// Migration: prisma/migrations/20260817020000_drop_inventory_rule.

model Supplier {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String          @default("")
  id             String          @id @default(cuid())
  name           String
  // Suppliers are treated as websites: the primary identifier is the store URL
  // that admin compares prices across. contact/email/phone/address are legacy
  // optional fields kept for backward compatibility.
  website        String?
  contact        String?
  email          String?
  phone          String?
  address        String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  prices         SupplierPrice[]

  @@index([organizationId])
}

model SupplierPrice {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String   @default("")
  id             String   @id @default(cuid())
  supplierId     String
  productId      String
  price          Float
  unit           String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@index([organizationId])
}

model Client {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId                   String                  @default("")
  deletedAt                        DateTime? // soft-delete (recoverable via Archived view)
  id                               String                  @id @default(cuid())
  name                             String
  email                            String?
  secondaryEmail                   String?
  phone                            String?
  secondaryPhone                   String?
  company                          String?
  address                          String?
  aptNumber                        String?
  city                             String?
  state                            String?
  zip                              String?
  notes                            String?
  discountPercent                  Float                   @default(0)
  // Customer-specific fixed pricing ("Change Total"). When set, new jobs for
  // this client default to this total. `fixedPriceRecurring` carries it
  // forward to generated recurring jobs. Frequency discounts are skipped for
  // fixed-price jobs unless `fixedPriceAllowFrequencyDiscount` is true.
  fixedPrice                       Float?
  fixedPriceRecurring              Boolean                 @default(false)
  fixedPriceAllowFrequencyDiscount Boolean                 @default(false)
  clientType                       ClientType              @default(RESIDENTIAL)
  serviceFrequency                 ServiceFrequency?
  isActive                         Boolean                 @default(true)
  // This customer is blocked from posting in job chat, on every one of their
  // bookings (CLN-P0-3-14 — "a specific booking or user"). NULL = allowed.
  chatDisabledAt                   DateTime?
  stripeCustomerId                 String?                 @unique
  defaultPaymentMethodId           String?
  referralCode                     String?                 @unique
  referralCredit                   Float                   @default(0)
  giftCardBalance                  Float                   @default(0)
  noShowCount                      Int                     @default(0)
  lastNoShowAt                     DateTime?
  referredByClientId               String?
  userId                           String?                 @unique
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  jobs                             Job[]
  invoices                         Invoice[]
  complaints                       Complaint[]
  waitlistEntries                  Waitlist[]
  addresses                        ClientAddress[]
  /// Customer-specific checklists (Stage 10 / PDF #10).
  checklistTemplates               ChecklistTemplate[]
  recurringCancellations           RecurringCancellation[]
  referredBy                       Client?                 @relation("ClientReferrals", fields: [referredByClientId], references: [id], onDelete: SetNull)
  referrals                        Client[]                @relation("ClientReferrals")
  contact                          Contact?
  paymentMethods                   ClientPaymentMethod[]

  @@index([clientType])
  @@index([isActive])
  @@index([referredByClientId])
  @@index([organizationId])
}

// Saved cards on a client profile. Client.defaultPaymentMethodId still points
// at the default Stripe payment-method id; this table lets admin save several
// cards, see them (brand/last4/expiry), remove them, and switch the default.
model ClientPaymentMethod {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId        String   @default("")
  id                    String   @id @default(cuid())
  clientId              String
  stripePaymentMethodId String   @unique
  brand                 String?
  last4                 String?
  expMonth              Int?
  expYear               Int?
  isDefault             Boolean  @default(false)
  label                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([organizationId])
}

/// Recurring-service cancellation + save-offer tracking. Created only when a
/// customer cancels their ENTIRE recurring service (not a single cleaning).
model RecurringCancellation {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String    @default("")
  id             String    @id @default(cuid())
  clientId       String
  frequency      String?
  reason         String?
  cancelledAt    DateTime  @default(now())
  emailSentAt    DateTime?
  offerType      String? // PERCENT | FIXED
  offerValue     Float?
  offerCode      String?
  // PENDING | SENT | OPENED | CLICKED | REPLIED | REDEEMED | EXPIRED | NONE
  offerStatus    String    @default("PENDING")
  openedAt       DateTime?
  clickedAt      DateTime?
  repliedAt      DateTime?
  reactivatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([offerStatus])
  @@index([cancelledAt])
  @@index([organizationId])
}

model ClientAddress {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId     String              @default("")
  id                 String              @id @default(cuid())
  clientId           String
  label              String              @default("Home")
  address            String
  aptNumber          String?
  /// awerfixes.pdf item 2 (round 3, stage 4). `postalCode`, not `zip`, even
  /// though Client carries the legacy flat trio (address/city/state/zip): the
  /// two are separate stores and are deliberately NOT merged. Client.* is the
  /// customer's billing address; these rows are the service address book.
  city               String?
  postalCode         String?
  /// Door codes, gate codes, buzzer numbers, parking instructions. Surfaced to
  /// the ASSIGNED cleaner on the job page — cleaners cannot get in without it.
  /// Never rendered on anything customer-facing or on an unclaimed job.
  accessNotes        String?
  /// ── PROPERTY SIZE (new photo/address fixes, item 3) ──────────────────────
  ///
  /// How big the place at THIS door is. The same five facts `Job` already
  /// carries — and that is the point: they were only ever stored per JOB, so an
  /// admin re-typed the customer's bedroom count on every single booking, and a
  /// customer with two properties had no way to say the condo is not the house.
  ///
  /// The job columns stay exactly where they are and stay authoritative FOR
  /// THAT JOB: they are the snapshot the visit was priced and staffed from, and
  /// a property that gains a bedroom next year must not rewrite last year's
  /// invoice. These columns are the DEFAULT that pre-fills a new booking at
  /// this address, and the value learned back from a booking when the row is
  /// still blank (see `upsertClientAddress`, which enriches blanks only).
  ///
  /// All nullable, with no defaults and no backfill: "not recorded" is the
  /// honest state for every row that predates this, and 0 bedrooms is a real
  /// answer that a DEFAULT would forge. `src/lib/property-size.ts` holds the
  /// rules; nothing here prices anything.
  propertyType       PropertyType?
  bedCount           Int?
  bathCount          Int?
  halfBathCount      Int?
  squareFootage      Int?
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobs               Job[]
  /// Location-specific checklists (Stage 10 / PDF #10).
  checklistTemplates ChecklistTemplate[]

  @@index([clientId])
  @@index([organizationId])
}

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
}

enum ServiceFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

model Job {
  // Tenant owner. NULL means "not yet assigned" during the multi-tenant
  // migration, and on platform-level rows that belong to no organization.
  // Enforced NOT NULL + RLS once every row is backfilled.
  organizationId                 String                @default("")
  // Soft delete — set when bulk/single deleted; hidden from lists, recoverable
  // from the Archived view. Never hard-deleted.
  deletedAt                      DateTime?
  id                             String                @id @default(cuid())
  // Allocated per organization by allocateJobNumber(), not by a global
  // sequence: every company numbers its own jobs from 1. Existing jobs keep the
  // numbers they were given -- those appear on invoices, in emails and on
  // printed sheets, so renumbering them would break every historical reference.
  jobNumber                      Int
  employeeId                     String?
  clientName                     String
  clientId                       String?
  location                       String?
  aptNumber                      String?
  /// Part of the denormalized address snapshot beside `location`/`aptNumber`
  /// (client feedback item 3). Typed on the job forms; also pushed onto the
  /// matching ClientAddress row by the shared upsert, blanks-only. No
  /// transportation fee is derived from it — that stayed manual entry, on the
  /// `parking` column below (labelled "Transportation" in the UI).
  postalCode                     String?
  /// PROVENANCE, not the source of truth (awerfixes.pdf item 2, round 3).
  /// `location`/`aptNumber` above stay the denormalized snapshot taken when the
  /// job was booked, so history survives an address being edited or deleted;
  /// this FK only records WHICH saved address it came from, which is what lets
  /// the cleaner view read that address's accessNotes. Hence onDelete: SetNull
  /// — removing an address must never blank a finished job or its invoice.
  clientAddressId                String?
  description                    String?
  jobType                        String?
  jobDate                        DateTime?
  startTime                      DateTime
  endTime                        DateTime?
  clockInTime                    DateTime?
  clockOutTime                   DateTime?
  status                         JobStatus             @default(CREATED)
  /// WHY this job is on hold (awerfixesaug18.pdf fix 6, round 4).
  ///
  /// Only ever set alongside `status = CREATED`, which from this round on MEANS
  /// on hold: `saveJob` stamps SCHEDULED explicitly when an admin creates a
  /// dated job, so `CREATED` stopped being the Prisma default leaking into the
  /// UI and became a deliberate state. The three automatic producers each write
  /// their trigger here — a $0 import, a post-construction quote awaiting a
  /// price, a flexible booking with no agreed date — from the fixed strings in
  /// src/lib/job-hold.ts, so "automatic holds show their trigger" is one string
  /// per trigger rather than prose retyped at each call site.
  ///
  /// Nullable, and NULL is not "no reason": it is "written before this column
  /// existed", which `holdReasonText()` renders as "Pending admin review" —
  /// something an admin can act on. `releaseJobHold` clears it as it moves the
  /// job to SCHEDULED, so a released job carries no stale explanation.
  holdReason                     String?
  price                          Float?
  employeePay                    Float?
  /// Is `employeePay` an authoritative MANUAL TEAM TOTAL, or a save-time
  /// estimate snapshot? (cleano_new_fixes.pdf fix 4, decision D2.)
  ///
  /// TRUE  — an admin typed it, or the BookingKoala CSV carried a provider/team
  ///         payment. `computeJobPayShares` pays it out, split evenly across the
  ///         crew, instead of running the tier math. The PDF: "if admin enters
  ///         $88.50, use it" / "do not show the stored value as not used".
  /// FALSE — a PERCENTAGE estimate written by saveJob at save time. It goes
  ///         stale the moment a rating lands or the multipliers are edited, so
  ///         it is superseded silently by the live calculation.
  ///
  /// Defaults FALSE, which is exactly today's behaviour for every existing row.
  employeePayIsManual            Boolean               @default(false)
  totalTip                       Float?
  parking                        Float?
  paymentReceived                Boolean               @default(false)
  invoiceSent                    Boolean               @default(false)
  notes                          String?
  paymentType                    PaymentType?
  discountAmount                 Float?
  // Why a discount was applied (awer_fixes.pdf item 29). Free-form so an admin
  // can type a reason the preset list doesn't cover; the UI offers the presets
  // in src/lib/discount-reasons.ts. Null on historical discounts, which the UI
  // shows as "No reason assigned" rather than inventing one.
  discountReason                 String?
  bedCount                       Int?
  bathCount                      Int?
  // DEPRECATED (AWER round 3, fix 1). The rating premium moved INTO the
  // cleaner's rate: individualRate = tier base x the cleaner's multiplier,
  // resolved per cleaner from Settings -> `multipliers.ratings` in
  // src/lib/cleaner-rates.ts. Nothing in the money path reads this column any
  // more (computeJobPayShares stopped multiplying by it). Kept rather than
  // dropped because live rows carry it and the jobs CSV importer still accepts
  // the column; writing it has NO effect on pay. Do not reintroduce a read.
  payRateMultiplier              Float?                @default(1.0)
  isFlexible                     Boolean               @default(false)
  requiredCleaners               Int                   @default(1)
  subtotalAmount                 Float                 @default(0)
  gstAmount                      Float                 @default(0)
  qstAmount                      Float                 @default(0)
  tipAmount                      Float                 @default(0)
  totalAmount                    Float                 @default(0)
  stripeSetupIntentId            String?
  stripePaymentIntentId          String?
  // UNIQUE: the deposit intent is the booking's idempotency key. A retry that
  // presents the same intent must return the job it already paid for, and one
  // paid intent must never mint a second booking. Postgres allows many NULLs
  // under a UNIQUE index, so admin/imported jobs (no deposit) are unaffected,
  // as are recurring child jobs — only the first visit carries the deposit.
  depositPaymentIntentId         String?               @unique
  depositPaid                    Boolean               @default(false)
  depositPaidAt                  DateTime?
  /// WHAT THE DEPOSIT ACTUALLY WAS, in dollars (PDF #9, Stage 11).
  ///
  /// Before this column the deposit was the literal 20, re-typed in six places,
  /// so a post-construction booking that charges $200 would have been refunded
  /// $20 and credited $20 against its invoice. Every reader now goes through
  /// `resolveDepositCredit()` in src/lib/booking-deposit.ts.
  ///
  /// Nullable, and NULL is not "unknown": every booking written before this
  /// charged exactly $20, so the fallback in that helper is the historically
  /// correct figure and no existing row changes value. Stored rather than
  /// re-derived from the setting, because the setting can be edited after a
  /// booking is taken and the job must still credit what it collected.
  depositAmount                  Float?
  /// Quote lifecycle for a booking that is priced AFTER review (PDF #9).
  /// NULL — every existing row — means "not a quote". See `enum QuoteStatus`
  /// above and `src/lib/quote-status.ts`.
  quoteStatus                    QuoteStatus?
  /// When the final price was emailed to the customer. Set alongside
  /// `quoteStatus = QUOTED`; NULL while a quote is still under review, so the
  /// admin panel can say "not sent yet" without reading the job log.
  quotedAt                       DateTime?
  /// The customer's own post-construction estimate, as entered in /book: hours
  /// of work and crew size (PDF #9, Stage 11).
  ///
  /// These drove `postConstructionBasePrice` and were then THROWN AWAY — the
  /// booking action priced with them and wrote neither, hardcoding
  /// `requiredCleaners: 1`, so nothing downstream could reconstruct the quote or
  /// staff the job. Persisted here as the customer's REQUEST, not as billing
  /// columns: what the customer is charged still lives in `price` /
  /// `billedHourlyRate` / `billed*Hours` like every other job.
  pcHours                        Float?
  pcCleaners                     Int?
  // The card this booking is attached to, captured when the booking was
  // confirmed. NULL means "no card was pinned" — every charge path falls back
  // to the client's current default, which is exactly the old behaviour, so
  // existing rows keep working untouched.
  //
  // Stores the Stripe `pm_` id rather than a ClientPaymentMethod row id: the
  // local mirror is deleted and recreated whenever it syncs from Stripe, so a
  // row id would dangle.
  stripePaymentMethodId          String?
  paymentFailedAt                DateTime?
  paymentFailureReason           String?
  paidAt                         DateTime?
  refundedAmount                 Float                 @default(0)
  isCashJob                      Boolean               @default(false)
  // Per-job sales-tax exemption (awer_fixes.pdf item 7). Applies to THIS job
  // only — never a global switch. When true, GST/QST are not added and the
  // total equals the discounted subtotal. Distinct from `isCashJob`, which is
  // a payment method that happens to also be untaxed: a job can be
  // card-paid AND tax-exempt. Cleaner pay is unaffected — it is always
  // calculated from the pre-tax job price.
  taxExempt                      Boolean               @default(false)
  // Cleaner pay model for this job. PERCENTAGE (default) = existing tier/split
  // math. FLAT = cleaner is shown a fixed payout only (no % of job price).
  // HOURLY = cleaner is shown an hourly rate. employeePay stays the payout.
  //
  // Round 4, fix 5: on an HOURLY job each cleaner is paid THEIR OWN clocked
  // hours × `hourlyRate` (all their sessions summed, their own breaks removed),
  // so `employeePay` — the team total — is the sum of those, and is rewritten
  // from the clock at final clock-out unless `employeePayIsManual` is set. With
  // no session rows the stored team total is split evenly, exactly as before.
  // See computeJobPayShares (src/lib/cleaner-earnings.ts) and
  // snapshotHourlyEmployeePay (src/lib/hourly-pay.server.ts).
  payType                        JobPayType            @default(PERCENTAGE)
  hourlyRate                     Float?
  // ── Customer-side hourly billing (PDF #8, Stage 8) ────────────────────────
  // DO NOT confuse these with `payType`/`hourlyRate` two lines above: those are
  // what the CLEANER is paid, these are what the CUSTOMER is charged. Before
  // this stage the second thing did not exist at all — an "hourly job" could
  // only mean hourly cleaner pay — which is exactly what PDF #8 reports.
  //
  // FLAT (the default, and every pre-existing row) = today's behaviour: `price`
  // is the base service line. HOURLY = the service line is
  // `billedHourlyRate × (billedActualHours ?? billedEstimatedHours)`, computed
  // by `hourlyServiceAmount()` and applied inside `computeJobMoney`. A manual
  // FINAL_PRICE override still wins over both — see src/lib/hourly-billing.ts.
  billingType                    JobBillingType        @default(FLAT)
  /// Customer-facing $/hr. Deliberately NOT named `hourlyRate`.
  billedHourlyRate               Float?
  /// What the admin quoted, in TOTAL CREW HOURS. Used until the job is worked.
  /// 30 means one cleaner for 30h or two for 15h — the crew size is already
  /// inside the number and is never multiplied in again.
  billedEstimatedHours           Float?
  /// Snapshotted from JobWorkSession at final clock-out, rounded to 0.25h
  /// (decision D7), and editable by an admin afterwards.
  ///
  /// TOTAL CREW HOURS — every cleaner's active time added up, so two cleaners
  /// on site for three hours is 6. This REVERSES the Stage 8 rule (elapsed /
  /// union) on the instruction of `awerfixesaug18.pdf` fix 4, under round 4's
  /// standing "the PDF wins" rule. See the long note in
  /// src/lib/hourly-billing.ts; the measurement itself is
  /// `crewActiveMinutes` in src/lib/work-sessions.ts, which is the same
  /// per-cleaner figure `hourlyRate` above is paid from.
  billedActualHours              Float?
  /// Itemized vs Final-price-override (cleano_new_fixes.pdf fix 2). Nullable on
  /// purpose: NULL = "not stamped", and `resolvePricingMode()` falls back to the
  /// old `bookingSource` rule for those rows, so the column can roll out without
  /// repricing a single historical job. Everything written from the fix onward
  /// stamps it explicitly — the admin picks it on the job form, the importer and
  /// the web booking flow stamp FINAL_PRICE.
  pricingMode                    JobPricingMode?
  // True when the price came from the client's customer-specific fixed price
  // (Client.fixedPrice) — shown as a badge on the job detail/list.
  usesFixedPrice                 Boolean               @default(false)
  // Per-booking notification mutes (admin-controlled, job detail page).
  // false = suppress client/provider notifications for THIS job only;
  // global NotificationSetting preferences are untouched.
  notifyClient                   Boolean               @default(true)
  notifyProvider                 Boolean               @default(true)
  // Job chat switched off for THIS booking (CLN-P0-3-14). NULL = messaging on,
  // which is every existing row. Read-only, never invisible: the history stays
  // rendered, only the composer goes away, because 3-10/3-15 require the record
  // to survive. Admins are exempt — moderation is why the switch exists.
  chatDisabledAt                 DateTime?
  appliedPromoCode               String?
  promoDiscountAmount            Float?
  // Calendar priority badge override. null = follow the auto rule
  // (calendar.jobTypeLabels setting, keyed by jobType); "ROUTINE" | "IMPORTANT"
  // | "NONE" = an operations manager's explicit switch on the job detail page.
  priorityLabel                  String?
  cancellationRequestedAt        DateTime?
  // Customer-facing cancellation reason (shown in the portal, visible to both
  // admin and customer). Distinct from internal NOTE_ADDED audit logs.
  cancellationReason             String?
  // Late-cancellation fee charged to the saved card when the customer
  // cancels within the 48h window (see CANCELLATION_FEE_USD in policy.ts).
  // `cancellationFeeChargedAt` makes the charge idempotent.
  cancellationFeeChargedAt       DateTime?
  cancellationFeePaymentIntentId String?
  rescheduleRequestedAt          DateTime?
  parentJobId                    String?
  bookingSource                  String?
  // External source's unique booking id (e.g. BookingKoala "Booking id") — the
  // idempotency key for imports, so concurrent same-time jobs aren't deduped away.
  externalBookingId              String?
  squareFootage                  Int?
  halfBathCount                  Int?
  /// Apartment/condo vs house (PDF #11, Stage 9). Property INFORMATION, in the
  /// same family as `bedCount`/`squareFootage` above — NOT a service category.
  /// `jobType` stays the answer to "what cleaning is this"; this answers "what
  /// kind of building". Nullable because "not recorded" is the honest state for
  /// every row written before this column and for a booking taken without it —
  /// see src/lib/property-type.ts, which is the only place the rules live.
  propertyType                   PropertyType?
  /// Per-job checklist override (PDF #10, Stage 10). NULL — every existing row
  /// — means "resolve automatically", which is the behaviour that already
  /// exists: address-scoped template → client-scoped template → the jobType /
  /// add-on default. Set, it PINS this job to one template and beats all three.
  ///
  /// Propagates across a recurring series (`SERIES_PROPAGATED_FIELDS`), because
  /// the PDF asks for "checklist assignment stays consistent when recurring
  /// jobs are generated" and a series is one agreement.
  ///
  /// onDelete: SetNull — deleting the template returns the job to automatic
  /// resolution rather than deleting the job.
  checklistTemplateId            String?
  // Rag-wash projection — computed from job specs at completion.
  // `washCreditsAwarded` flips to true once credits are written to
  // the assigned cleaner ledger(s), making the award idempotent.
  washProjectedRags              Int?
  washProjectedPads              Int?
  washCappedRags                 Int?
  washCappedPads                 Int?
  washActualRags                 Int?
  washActualPads                 Int?
  washCreditsAwarded             Boolean               @default(false)
  // "On My Way" — set when the cleaner presses On My Way before clocking in.
  // Visible to admin; triggers the customer on-the-way notification. Clock-in
  // is still separate. onMyWayLat/Lng capture the cleaner's location at press
  // time (optional, only when the cleaner grants geolocation) for live ETA.
  onMyWayAt                      DateTime?
  onMyWayLat                     Float?
  onMyWayLng                     Float?
  onMyWayLocationAt              DateTime?
  // No-show + late-arrival event timestamps (admin action + clock-in watcher).
  noShowAt                       DateTime?
  lateArrivalAt                  DateTime?
  // Stars deducted from this job's customer rating because the cleaner arrived
  // late (flat −0.5 past the 10-min grace; see src/lib/policy.ts). Column name
  // kept as the legacy "lateArrivalRatingCap" to avoid a migration.
  lateArrivalRatingPenalty       Float?                @map("lateArrivalRatingCap")
  // Manager override for the Rag Wash review flag.
  washReviewOverrideAt           DateTime?
  washReviewOverrideBy           String?
  // Card hold lifecycle. `holdPaymentIntentId` is set when admin (or the
  // booking flow) places a manual-capture PI for the full job price.
  holdPaymentIntentId            String?
  holdPlacedAt                   DateTime?
  holdAmount                     Float?
  holdCapturedAt                 DateTime?
  holdReleasedAt                 DateTime?
  holdCaptureFailedAt            DateTime?
  holdCaptureFailReason          String?
  // After-photos are ALLOWED by default (spec item 21) — this flag is now an
  // opt-out: admin sets it false on a specific job to block after-photos.
  // `afterPhotoOverrideAt` records an explicit admin re-allow.
  afterPhotoConsent              Boolean               @default(true)
  afterPhotoConsentAt            DateTime?
  afterPhotoConsentVersion       String?
  afterPhotoOverrideAt           DateTime?
  // SMS notification consent captured at booking time (default checked, admin
  // setting customer.smsOptInDefault). Existing rows default to true.
  smsConsent                     Boolean               @default(true)
  afterPhotoOverrideBy           String?
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt
  employee                       User?                 @relation("EmployeeJobs", fields: [employeeId], references: [id], onDelete: SetNull)
  client                         Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientAddress                  ClientAddress?        @relation(fields: [clientAddressId], references: [id], onDelete: SetNull)
  checklistTemplate              ChecklistTemplate?    @relation("JobChecklistTemplate", fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  parentJob                      Job?                  @relation("JobRecurrence", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs                      Job[]                 @relation("JobRecurrence")
  productUsage                   JobProductUsage[]
  inventoryFlags                 InventoryFlag[]
  cleaners                       User[]                @relation("JobCleaners")
  assignmentInvites              JobAssignmentInvite[]
  logs                           JobLog[]
  addOns                         JobAddOn[]
  transactions                   Transaction[]
  invoices                       Invoice[]
  invoiceLineItems               InvoiceLineItem[]     @relation("InvoiceLineJobs")
  photos                         JobPhoto[]
  reviewPhotos                   ReviewPhoto[]
  chatMessages                   JobChatMessage[]
  assignments                    JobAssignment[]
  breaks                         JobBreak[]
  workSessions                   JobWorkSession[]
  checklists                     JobChecklist[]
  ratings                        EmployeeRating[]
  complaints                     Complaint[]
  emailLogs                      EmailLog[]
  ratingTokens                   JobRatingToken[]
  strikes                        CleanerStrike[]
  convertedFromLeads             Lead[]
  convertedFromWaitlist          Waitlist[]
  commissions                    Commission[]

  @@unique([organizationId, jobNumber])
  @@index([jobDate])
  @@index([clientName])
  @@index([clientId])
  @@index([status])
  @@index([parentJobId])
  @@index([clientAddressId])
  @@index([checklistTemplateId])
  @@index([isFlexible])
  @@index([externalBookingId])
  // Used to answer "which bookings is this card attached to?" — needed before
  // a card can be safely removed.
  @@index([stripePaymentMethodId])
  @@index([organizationId])
}

model JobAddOn {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String   @default("")
  id             String   @id @default(cuid())
  jobId          String
  name           String
  /// The UNIT price. Every consumer computes `price * quantity` — see
  /// addOnLineTotal() in src/lib/job-money.ts, which is the only place that
  /// multiplication should be written.
  price          Float    @default(0)
  /// How many of this add-on the customer booked (awerfixes item 7, round 3).
  /// Always >= 1; clamped by addOnQuantity() at every parse boundary rather
  /// than by a CHECK constraint, which Prisma cannot model without drift.
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([organizationId])
}

model PricingRule {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String   @default("")
  id             String   @id @default(cuid())
  bedCount       Int
  bathCount      Int
  basePrice      Float
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, bedCount, bathCount])
  @@index([organizationId])
}

model JobProductUsage {
