  status            JobApplicationStatus @default(NEW)
  notes             String?
  source            String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  // Applicant portal account (decision D4). Null until an admin sends a
  // portal invite — an application with no invite behaves exactly as today.
  // @unique: one portal account per application; a re-applying candidate is
  // linked to the application the admin chose to invite, not every row that
  // shares their email.
  userId            String?              @unique
  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
