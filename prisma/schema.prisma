enum JobChatSenderRole {
  CLEANER
  CLIENT
  ADMIN
}

// Job-specific chat thread between the assigned cleaner and the client (admin
// can view/moderate). Keyed by jobId — the job IS the thread. In-app both sides
// (client uses the customer portal); a Twilio SMS bridge can be layered later.
model JobChatMessage {
  id         String            @id @default(cuid())
  jobId      String
  senderId   String?
  senderRole JobChatSenderRole
  senderName String
  body       String            @db.Text
  readByAdminAt    DateTime?
  readByClientAt   DateTime?
  readByCleanerAt  DateTime?
  createdAt  DateTime          @default(now())
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

// Cleaner group chat (spec #15). One default "All cleaners" channel; admin can
// create more and moderate (soft-delete messages). Visible to all cleaners.
model GroupChannel {
  id        String         @id @default(cuid())
  name      String
  isDefault Boolean        @default(false)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  GroupMessage[]
}

model GroupMessage {
  id         String       @id @default(cuid())
  channelId  String
  senderId   String
  senderName String
  body       String       @db.Text
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())
  channel    GroupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// Photos a CLIENT attaches to a poor review. Distinct from JobPhoto (cleaner
// before/after photos) — these have no employeeId and are created from the
// public/portal rating flow. Visible to admin alongside the review.
model ReviewPhoto {
  id        String   @id @default(cuid())
  jobId     String
  url       String
  rating    Int?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ChecklistTemplate {
  id            String                  @id @default(cuid())
  name          String
  jobType       String?
  addOnName     String?
  description   String?
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
