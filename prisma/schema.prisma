  videoProgress Float          @default(0)
  quizScore     Float?
  quizAttempts  Int            @default(0)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  module        TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  employee      User           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([moduleId, employeeId])
  @@index([moduleId])
  @@index([employeeId])
}

model EmployeeRating {
  id             String    @id @default(cuid())
  employeeId     String
  jobId          String?
  rating         Float
  notes          String?
  ratedBy        String?
  // Set when the client edits their submitted rating (shown to admin).
  editedAt       DateTime?
  // Admin exclusion (AwerNewFixes.pdf item 5). An excluded rating is KEPT —
  // the row stays for admin review — but drops out of every average, rating
  // count and pay-tier calculation. Used for a rating left on a test job, a
  // cancelled job, a mis-tap, or a complaint the office resolved in the
  // cleaner's favour. NULL = active. Reads must filter on `excludedAt: null`.
  excludedAt     DateTime?
  /// User id of the admin who excluded it (matches `ratedBy`'s convention).
  excludedById   String?
  excludedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  job            Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([jobId])
  @@index([createdAt])
  // Averages/counts always read the ACTIVE subset (item 5).
