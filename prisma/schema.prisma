/// A file the EMPLOYEE uploads about themselves, as opposed to a Document the
/// company assigns them to sign (awerfixes.pdf item 16 — void cheque upload).
/// Today `kind` only ever holds "VOID_CHEQUE"; it is a String rather than an
/// enum so the next payroll artefact (T4, direct-deposit form) needs no
/// migration.
///
/// APPEND-ONLY. Replacing a void cheque writes a NEW row and the newest row is
/// the current one, so a cleaner cannot quietly swap their banking details with
/// no trace of what was there before.
///
/// PRIVACY (decision 7). `fileUrl` is an `authenticated` Cloudinary URL and is
/// USELESS on its own — fetching it unsigned is denied. Viewing goes through
/// `getEmployeeFileUrl`, which is OWNER/ADMIN-gated, mints a short-lived signed
/// URL and writes an ActivityLog row. `publicId` + `resourceType` are stored
/// because signing needs both and the repo's only URL→public-id parser
/// (deleteJobPhoto.ts) assumes an `/upload/` path it will never see here.
model EmployeeFile {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String   @default("")
  id             String   @id @default(cuid())
  employeeId     String
  kind           String // VOID_CHEQUE
  fileUrl        String
  publicId       String
  resourceType   String   @default("image") // Cloudinary resource_type: image | raw
  fileName       String
  mimeType       String
  uploadedAt     DateTime @default(now())
  employee       User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // The only read this table serves: "newest file of this kind for this
  // employee". One index covers it.
  @@index([employeeId, kind, uploadedAt])
  @@index([organizationId])
}

