enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DEAD
  OUT_OF_AREA
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum EmailKind {
  BOOKING_CONFIRMATION
  REMINDER_24H
  RECEIPT
  REFUND
  WAITLIST_AVAILABLE
  RATING_REQUEST
  PASSWORD_SETUP
  OTHER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

enum JobApplicationStatus {
  NEW
  CONTACTED
  INTERVIEWING
  HIRED
  REJECTED
  ARCHIVED
}

/// Cleaner job-application intake from the public careers page.
model JobApplication {
  id                String               @id @default(cuid())
  // Personal information
  name              String // combined "First Last", kept for display/avatars
  firstName         String?
  lastName          String?
  gender            String?
  dateOfBirth       String? // "YYYY-MM-DD"
  email             String
  phone             String?
  addressStreet     String?
  addressLine2      String?
  cityArea          String? // City
  province          String? // State / Province
  postalCode        String?
  country           String?
  // Transportation
  hasTransport      Boolean? // reliable vehicle
  driversLicense    String?
  hasInsurance      Boolean?
  insuranceDetails  String?
  // Availability
  availability      String? // legacy / readable summary
  availableDays     String[]             @default([])
  preferredHours    String?
  earliestStart     String? // "YYYY-MM-DD"
  // Experience
  yearsExperience   String?
  experienceTypes   String[]             @default([])
  experience        String? // free-text description
  resumeUrl         String?
  // About you
  whyCleano         String?
  hasConviction     Boolean?
  convictionDetails String?
  hearAbout         String?
  referrerName      String?
  // References
  ref1Name          String?
  ref1Relationship  String?
  ref1Phone         String?
  ref2Name          String?
  ref2Relationship  String?
  ref2Phone         String?
  // Background-check consent
  backgroundConsent Boolean              @default(false)
  consentDate       String? // "YYYY-MM-DD"
  // Meta
  status            JobApplicationStatus @default(NEW)
  notes             String?
  source            String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum JobInviteDecision {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum GiftCardStatus {
  PENDING_PAYMENT
  ACTIVE
  REDEEMED
  REFUNDED
  CANCELLED
}

/**
 * One-time token a customer uses on the public /add-card/[token] page
 * to save their card on file without needing a portal login. The link
 * is emailed by admin via the job detail "Send Add card link" action.
 */
model ClientCardSetupToken {
  id        String    @id @default(cuid())
  clientId  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  jobId     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
  @@index([expiresAt])
}

model GiftCard {
  id                    String         @id @default(cuid())
  code                  String         @unique
  amount                Float
  status                GiftCardStatus @default(PENDING_PAYMENT)
  // Buyer
  purchaserName         String
  purchaserEmail        String
  purchaserClientId     String?
  // Recipient (buyer can also be the recipient = same as purchaser fields)
  recipientName         String
  recipientEmail        String
  personalMessage       String?
  // Optional scheduled delivery; if null we send right after purchase.
  scheduledDeliveryDate DateTime?
  deliveredAt           DateTime?
  // Cover photo key (e.g. "birthday", "holiday", "thankyou", "default").
  // The actual image URL lives in src/lib/gift-cards/covers.ts.
  coverKey              String         @default("default")
  // Stripe purchase PaymentIntent.
  stripePaymentIntentId String?
  // Redemption tracking
  redeemedAt            DateTime?
  redeemedByClientId    String?
  // Audit
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([status])
  @@index([recipientEmail])
  @@index([scheduledDeliveryDate])
  @@index([createdAt])
}

model JobAssignmentInvite {
  id            String            @id @default(cuid())
  jobId         String
  cleanerId     String
  decision      JobInviteDecision @default(PENDING)
  sentAt        DateTime          @default(now())
  respondedAt   DateTime?
  expiresAt     DateTime
  declineReason String?
  // If true, this invite was created as part of a last-minute reposting
  // and the cleaner who accepts earns the configured bonus.
  isLastMinute  Boolean           @default(false)
  bonusUsd      Float             @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cleaner       User              @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([jobId, cleanerId])
  @@index([cleanerId, decision])
  @@index([expiresAt])
}

model QuoteRequest {
  id            String             @id @default(cuid())
  name          String
  email         String
  phone         String?
  address       String?
  serviceType   String?
  bedCount      Int?
  bathCount     Int?
  squareFootage Int?
  preferredDate DateTime?
  message       String?
  status        QuoteRequestStatus @default(NEW)
  source        String?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ServiceArea {
  id        String   @id @default(cuid())
  prefix    String   @unique
  zoneName  String
  isActive  Boolean  @default(true)
  travelFee Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

