/// Three-strike accountability. Strikes roll off 30 days after they're
/// applied (rolling window) — `expiresAt` is that reset date. Excused /
/// removed strikes stop counting immediately. Active = ACTIVE + expiresAt > now.
enum StrikeReason {
  LATE_45
  NO_SHOW
  LOW_RATINGS_CONSECUTIVE
  REFUND_COMPLAINT
  LATE_CANCEL
  JOB_ABANDONMENT
  FALSIFIED_CLOCK
  CHECKLIST_FAILURE
  UNAPPROVED_PERSON
  MISCONDUCT
  MANUAL
}

enum StrikeStatus {
  ACTIVE
  EXPIRED
  EXCUSED
  REMOVED
}

model CleanerStrike {
  id          String       @id @default(cuid())
  cleanerId   String
  reasonCode  StrikeReason
  reason      String
  jobId       String?
  status      StrikeStatus @default(ACTIVE)
  isAuto      Boolean      @default(true)
  appliedById String?
  adminNote   String?
  excusedById String?
  excusedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cleaner     User         @relation("CleanerStrikes", fields: [cleanerId], references: [id], onDelete: Cascade)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([cleanerId])
  @@index([status])
  @@index([jobId])
  @@index([expiresAt])
}

