model JobPhoto {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String       @default("")
  id             String       @id @default(cuid())
  jobId          String
  /// WHO uploaded it. NULL = the CUSTOMER did, from the public booking flow
  /// (PDF #9, Stage 11) — there is no `User` row for a guest booker and no crew
  /// assigned yet, so the only honest value is "nobody on staff".
  ///
  /// Was NOT NULL until Stage 11, which is precisely why the earlier round of
  /// fixes shipped post-construction photo *prompts* instead of photo *uploads*
  /// (see verify-awer-fixes-3.ts §10). Every pre-existing row has an employee,
  /// so nothing changes for cleaner-uploaded photos; readers label a null
  /// uploader rather than assuming one.
  employeeId     String?
  url            String
  caption        String?
  /// WHAT this photo documents (new photo/address fixes, item 1).
  ///
  /// Before this column the only discriminator was the free-text `caption`, so
  /// "before", "after" and "the fridge door is broken" were indistinguishable
  /// to anything but a human reading them one at a time. The handoff asks for
  /// photos that "stay organized by upload type", which needs a column.
  ///
  /// NOT NULL with a `GENERAL` default on purpose: every pre-existing row is
  /// genuinely un-classified, and GENERAL is the honest name for that — it is
  /// the bucket the galleries show without a badge. A nullable column would
  /// have meant the same thing while forcing every reader to handle a fourth
  /// state that is really the fifth value of a four-value enum.
  kind           JobPhotoKind @default(GENERAL)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Cascade is kept from before: deleting a cleaner still removes the photos
  /// they took. It can never fire for a booking photo, whose employeeId is NULL.
  employee       User?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([employeeId])
  /// The galleries group and filter by type within one job, which is exactly
  /// this pair — and the per-job photo cap counts rows the same way.
  @@index([jobId, kind])
  @@index([organizationId])
}

/// How a job photo is filed (new photo/address fixes, item 1).
///
///   BEFORE   the state of the space on arrival
///   AFTER    the state of the space at hand-off
///   ISSUE    damage, a blocked room, something the office must see
///   GENERAL  everything else, and every row that predates this enum
///
/// Deliberately NOT derived from `caption`: a caption is prose a cleaner types
/// on a phone, and pattern-matching it would silently misfile the ones that
/// most need to be found later.
enum JobPhotoKind {
  BEFORE
  AFTER
  ISSUE
  GENERAL
}

