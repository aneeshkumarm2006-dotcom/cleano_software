/// Sales-rep commission ledger (client feedback item 20, Stage 11.2 — "for
/// sales leads, I wanted to add another section over here that is for
/// commissions, for commissions on sales reps. If we're paying them any
/// commissions, we could track it over here").
///
/// Entries are recorded by hand: nothing in the app knows which rep sourced a
/// booking, so there is no rule to derive an amount from. `rate` is stored
/// alongside `amount` when the admin worked the figure out as a percentage, so
/// the arithmetic behind a number is visible a month later; `amount` is always
/// the payable and is never recomputed from `rate`.
///
/// `salesRepId` is a `User`. That is the only person table in this app that
/// isn't a customer, and it is already how the CRM models a rep
/// (`Contact.ownerId`). If Cleano pays commission to canvassers who have no
/// login, this becomes a small `SalesRep` table and an FK swap — see the
/// TODO(client) note in the Commissions tab.
///
/// `paidAt` IS the status: null = pending, set = paid. A rep's totals are the
/// two sums either side of that one column.
model Commission {
  // Tenant owner. Required: a row that cannot name its organization is a row
  // no isolation rule can protect.
  organizationId String    @default("")
  id             String    @id @default(cuid())
  salesRepId     String
  jobId          String?
  leadId         String?
  amount         Float
  /// Percentage the amount was worked out at, when there was one (0–100).
  rate           Float?
  note           String?
  /// Payout month bucket, "YYYY-MM". Same shape as `Budget.period`, produced by
  /// `storeMonthPeriod()` so the month is the store's, not the server's.
  period         String
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  salesRep       User      @relation("SalesRepCommissions", fields: [salesRepId], references: [id], onDelete: Restrict)
  job            Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([salesRepId])
  @@index([period])
  @@index([paidAt])
  @@index([jobId])
  @@index([leadId])
  @@index([organizationId])
}

