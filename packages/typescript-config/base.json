{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Bookmops base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true
  }
}
