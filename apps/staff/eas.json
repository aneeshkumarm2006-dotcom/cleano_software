{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_PLATFORM_URL": "https://useawer.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_PLATFORM_URL": "https://useawer.com" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    }
  }
}
