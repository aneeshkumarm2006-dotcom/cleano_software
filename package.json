{
  "name": "bookmops",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@bookmops/web --",
    "build": "turbo run build --",
    "typecheck": "turbo run typecheck --",
    "lint": "turbo run lint --",
    "start": "npm run start -w @bookmops/web --",
    "verify": "npm run verify -w @bookmops/web --"
  },
  "devDependencies": {
    "turbo": "2.11.4"
  }
}
