{
  "name": "bookmops",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bookmops/web --",
    "build": "npm run build -w @bookmops/web --",
    "start": "npm run start -w @bookmops/web --",
    "lint": "npm run lint -w @bookmops/web --",
    "typecheck": "npm run typecheck -w @bookmops/web --",
    "verify": "npm run verify -w @bookmops/web --"
  }
}
